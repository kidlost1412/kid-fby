            </Border>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Grid VerticalAlignment="Center"><Image Source="{DynamicResource DecoRibbon}" Stretch="Fill" Height="16" VerticalAlignment="Bottom" Margin="-8,0,-12,2" IsHitTestVisible="False"/><TextBlock Text="Kho" Style="{DynamicResource TextTitle}"/></Grid><Image Source="{DynamicResource DecoStar}" Width="22" Height="22" Margin="8,0,0,8" VerticalAlignment="Center"/></StackPanel>
            <TextBlock x:Name="TxtGalleryCount" Text="0 video" Style="{DynamicResource TextMutedStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="16,0,0,0"/>
