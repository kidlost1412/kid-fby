                      <TextBlock x:Name="TxtLogoDefaultHint" Text="Logo Kid mặc định" FontSize="13" Foreground="{DynamicResource TextSubtle}" Margin="16,0,16,4" VerticalAlignment="Center" IsHitTestVisible="False"/>
