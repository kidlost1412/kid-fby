                    <Button x:Name="BtnDefaultLogo" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Content="Logo Kid" Style="{DynamicResource BtnGhost}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
