<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Kid FB.Y"
        Width="1440" Height="900" MinWidth="1200" MinHeight="720"
        WindowStartupLocation="Manual"
        Background="{DynamicResource Surface0}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <!--
    Kid FB.Y - cay cua so chinh (nap boi core\kid-fby-gui.ps1).
    Moi mau/style lay tu Theme.xaml qua DynamicResource (theme duoc merge sau khi parse).
    Ten x:Name duoc code dung qua $ui[...] - doi ten phai sua dong bo danh sach trong GUI va SelfTest.
  -->
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
  </shell:WindowChrome.WindowChrome>

  <Grid x:Name="RootGrid" Background="{DynamicResource Surface0}">
    <Grid.RowDefinitions>
      <RowDefinition Height="44"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ===================================================== thanh tieu de -->
    <Border Grid.Row="0" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
          <Border Width="24" Height="24" CornerRadius="6" Background="{DynamicResource Accent}" Margin="0,0,10,0">
            <TextBlock Text="&#xE714;" Style="{DynamicResource Icon}" FontSize="12" Foreground="{DynamicResource TextOnAccent}"/>
          </Border>
          <TextBlock Text="Kid FB.Y" FontFamily="Segoe UI Semibold" FontSize="14" VerticalAlignment="Center"/>
          <TextBlock x:Name="TxtAppVersion" Text="v1.0.0" Style="{DynamicResource TextCaption}" VerticalAlignment="Center" Margin="8,1,0,0"/>
        </StackPanel>

        <StackPanel x:Name="HeaderBadges" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Border x:Name="ChipDevice" Style="{DynamicResource Chip}" ToolTip="Chưa kiểm tra thiết bị Android. Bấm để kiểm tra."
                  AutomationProperties.Name="Trạng thái thiết bị">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="ChipDeviceDot" Text="●" FontSize="10" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBlock Text="&#xE8EA;" Style="{DynamicResource Icon}" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,6,0"/>
              <TextBlock x:Name="ChipDeviceText" Text="Thiết bị" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <Border x:Name="ChipTools" Style="{DynamicResource Chip}" ToolTip="Chưa kiểm tra công cụ. Bấm để mở Cài đặt › Công cụ."
                  AutomationProperties.Name="Trạng thái công cụ">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="ChipToolsDot" Text="●" FontSize="10" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBlock Text="&#xE90F;" Style="{DynamicResource Icon}" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,6,0"/>
              <TextBlock x:Name="ChipToolsText" Text="Công cụ" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="3" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button x:Name="BtnWinMin" Style="{DynamicResource WinBtn}" Content="&#xE921;" ToolTip="Thu nhỏ" AutomationProperties.Name="Thu nhỏ"/>
          <Button x:Name="BtnWinMax" Style="{DynamicResource WinBtn}" Content="&#xE922;" ToolTip="Phóng to" AutomationProperties.Name="Phóng to"/>
          <Button x:Name="BtnWinClose" Style="{DynamicResource WinBtnClose}" Content="&#xE8BB;" ToolTip="Đóng" AutomationProperties.Name="Đóng"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===================================================== than: sidebar | trang | xem truoc -->
    <Grid Grid.Row="1" x:Name="BodyGrid">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="72"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition x:Name="ColPreview" Width="0"/>
      </Grid.ColumnDefinitions>

      <!-- Sidebar -->
      <Border Grid.Column="0" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
        <DockPanel Margin="0,10,0,10">
          <RadioButton x:Name="NavSettings" DockPanel.Dock="Bottom" Style="{DynamicResource NavButton}" Tag="&#xE713;" Content="Cài đặt"
                       HorizontalAlignment="Center" ToolTip="Cài đặt (Ctrl+5)" AutomationProperties.Name="Cài đặt"/>
          <Border DockPanel.Dock="Bottom" Style="{DynamicResource Divider}" Margin="14,6"/>
          <StackPanel HorizontalAlignment="Center">
            <RadioButton x:Name="NavSource" Style="{DynamicResource NavButton}" Tag="&#xE71B;" Content="Nguồn" IsChecked="True"
                         ToolTip="Nguồn: link và thư mục xuất (Ctrl+1)" AutomationProperties.Name="Nguồn"/>
            <RadioButton x:Name="NavBrand" Style="{DynamicResource NavButton}" Tag="&#xE790;" Content="Thương hiệu"
                         ToolTip="Thương hiệu: logo và GIF (Ctrl+2)" AutomationProperties.Name="Thương hiệu"/>
            <RadioButton x:Name="NavQueue" Style="{DynamicResource NavButton}" Tag="&#xE8FD;" Content="Hàng đợi"
                         ToolTip="Hàng đợi đang chạy (Ctrl+3)" AutomationProperties.Name="Hàng đợi"/>
            <RadioButton x:Name="NavLibrary" Style="{DynamicResource NavButton}" Tag="&#xE8F1;" Content="Kho"
                         ToolTip="Kho video đã lưu (Ctrl+4)" AutomationProperties.Name="Kho"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Cac trang (chong cung mot o) -->
      <Grid x:Name="PageHost" Grid.Column="1">

        <!-- ================================================= NGUON -->
        <Grid x:Name="ViewSource" Margin="24,20,24,16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Nguồn" Style="{DynamicResource TextTitle}"/>
            <TextBlock Text="Dán link Reel hoặc video Facebook, mỗi dòng một link. Bấm Bắt đầu (Ctrl+Enter) ở thanh dưới để chạy."
                       Style="{DynamicResource TextMutedStyle}" Margin="0,4,0,0"/>
          </StackPanel>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="16"/>
              <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- O link -->
            <Border Style="{DynamicResource Card}" Padding="16">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,12" LastChildFill="False">
                  <TextBlock Text="Danh sách link" Style="{DynamicResource TextHeading}" VerticalAlignment="Center"/>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BtnPasteLinks" Margin="0,0,8,0" ToolTip="Dán link từ clipboard" AutomationProperties.Name="Dán link">
                      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE77F;" Style="{DynamicResource Icon}" FontSize="13" Margin="0,0,6,0"/><AccessText Text="_Dán"/></StackPanel>
                    </Button>
                    <Button x:Name="BtnImportLinks" Margin="0,0,8,0" ToolTip="Nhập link từ file .txt" AutomationProperties.Name="Nhập file txt">
                      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8E5;" Style="{DynamicResource Icon}" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="Nhập .txt"/></StackPanel>
                    </Button>
                    <Button x:Name="BtnClearLinks" Style="{DynamicResource BtnGhost}" ToolTip="Xóa toàn bộ link (Ctrl+Z để hoàn tác)" AutomationProperties.Name="Xóa danh sách link">
                      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{DynamicResource Icon}" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="Xóa"/></StackPanel>
                    </Button>
                  </StackPanel>
                </DockPanel>
                <Grid Grid.Row="1">
                  <TextBox x:Name="TxtLinks" Style="{DynamicResource TextBoxMono}" AcceptsReturn="True" AcceptsTab="False" TextWrapping="NoWrap"
                           VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MinHeight="230" Padding="12,10"
                           FontSize="13" AutomationProperties.Name="Danh sách link Facebook"/>
                  <TextBlock x:Name="TxtLinksPlaceholder" IsHitTestVisible="False" Margin="15,12,12,12" FontFamily="Cascadia Mono, Consolas"
                             FontSize="13" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap"
                             Text="https://www.facebook.com/reel/1234567890&#x0a;https://www.facebook.com/share/r/AbCdEf/&#x0a;https://fb.watch/xyz/&#x0a;&#x0a;Mỗi dòng một link. Link trùng hoặc đã loại sẽ được báo ở thẻ Tóm tắt."/>
                </Grid>
              </Grid>
            </Border>

            <!-- Cot phai: tom tat + thu muc xuat -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <Border Style="{DynamicResource Card}" Margin="0,0,0,16">
                  <StackPanel>
                    <TextBlock Text="Tóm tắt" Style="{DynamicResource TextHeading}"/>
                    <TextBlock x:Name="TxtLinkSummary" Text="Chưa có link nào" Style="{DynamicResource TextBody}" Margin="0,8,0,0"/>
                    <TextBlock x:Name="TxtDuplicateWarning" Visibility="Collapsed" Style="{DynamicResource TextMutedStyle}" Margin="0,6,0,0"/>
                    <StackPanel x:Name="PanelDupChoice" Margin="0,12,0,0" Visibility="Collapsed">
                      <TextBlock Text="Với video đã có trong kho" Style="{DynamicResource TextLabel}" Margin="0,0,0,6"/>
                      <RadioButton x:Name="RbDupSkip" GroupName="DupChoice" Content="Bỏ qua, chỉ chạy video mới" IsChecked="True" Margin="0,0,0,6"/>
                      <RadioButton x:Name="RbDupRedownload" GroupName="DupChoice" Content="Tải và ghi âm lại"/>
                    </StackPanel>
                  </StackPanel>
                </Border>
                <Border Style="{DynamicResource Card}" Margin="0,0,0,16">
                  <StackPanel>
                    <TextBlock Text="Thư mục xuất" Style="{DynamicResource TextHeading}"/>
                    <TextBox x:Name="TxtOut" Margin="0,10,0,10" AutomationProperties.Name="Thư mục xuất"/>
                    <StackPanel Orientation="Horizontal">
                      <Button x:Name="BtnPick" Margin="0,0,8,0" AutomationProperties.Name="Chọn thư mục xuất">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8DA;" Style="{DynamicResource Icon}" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="Chọn…"/></StackPanel>
                      </Button>
                      <Button x:Name="BtnOpenOut" Style="{DynamicResource BtnGhost}" AutomationProperties.Name="Mở thư mục xuất">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" Style="{DynamicResource Icon}" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="Mở"/></StackPanel>
                      </Button>
                    </StackPanel>
                  </StackPanel>
                </Border>
                <Border Style="{DynamicResource Card}">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE946;" Style="{DynamicResource Icon}" FontSize="14" Foreground="{DynamicResource Info}"
                               VerticalAlignment="Top" Margin="0,2,10,0"/>
                    <TextBlock x:Name="TxtLanguagePolicy" Style="{DynamicResource TextMutedStyle}"
                               Text="Ứng dụng chọn tiếng Việt trên Meta và tự bỏ qua video không có bản lồng tiếng. Việc xác nhận dựa vào giao diện Facebook, không phân tích ngôn ngữ trong âm thanh."/>
                  </DockPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>

        <!-- ================================================= THUONG HIEU -->
        <Grid x:Name="ViewBrand" Visibility="Collapsed" Margin="24,20,24,16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,16" LastChildFill="False">
            <StackPanel>
              <TextBlock Text="Thương hiệu" Style="{DynamicResource TextTitle}"/>
              <TextBlock Text="Logo và GIF được chèn vào mọi video khi chạy hàng đợi. Kéo trực tiếp trên khung xem trước bên phải."
                         Style="{DynamicResource TextMutedStyle}" Margin="0,4,0,0"/>
            </StackPanel>
            <Border DockPanel.Dock="Right" Style="{DynamicResource Badge}" Background="{DynamicResource AccentSubtle}" VerticalAlignment="Top" Padding="10,4">
              <TextBlock x:Name="TxtWatermarkSummary" Text="Logo: 30% · GIF: Tắt" FontSize="12" Foreground="{DynamicResource Accent}"/>
            </Border>
          </DockPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
              <!-- Logo -->
              <Border Style="{DynamicResource Card}" Margin="0,0,0,16">
                <StackPanel>
                  <DockPanel Margin="0,0,0,12">
                    <CheckBox x:Name="ChkWatermark" Content="Chèn logo" IsChecked="True" FontFamily="Segoe UI Semibold" FontSize="16"/>
                  </DockPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="64"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="52" Height="52" CornerRadius="8" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            HorizontalAlignment="Left" Padding="4">
                      <Image x:Name="ImgLogoPreview" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                      <TextBlock x:Name="TxtLogoName" Text="Đang dùng: Logo Kid" Style="{DynamicResource TextLabel}" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                      <Grid>
                        <TextBox x:Name="TxtLogoPath" IsReadOnly="True" FontSize="12" ToolTip="Đường dẫn đầy đủ của logo PNG đã chọn." AutomationProperties.Name="Đường dẫn logo"/>
                        <TextBlock x:Name="TxtLogoDefaultHint" Text="Logo Kid mặc định" FontSize="12" Foreground="{DynamicResource TextSubtle}" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                      </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                      <Button x:Name="BtnPickLogo" Content="Chọn PNG…" Margin="0,0,8,0"/>
                      <Button x:Name="BtnDefaultLogo" Content="Logo Kid" Style="{DynamicResource BtnGhost}"/>
                    </StackPanel>
                  </Grid>
                  <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="110"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Kích thước" Style="{DynamicResource TextMutedStyle}" VerticalAlignment="Center"/>
                    <Slider x:Name="SldLogoSize" Grid.Column="1" Minimum="5" Maximum="60" Value="30" TickFrequency="1" IsSnapToTickEnabled="True"
                            SmallChange="1" LargeChange="5" AutomationProperties.Name="Kích thước logo"/>
                    <TextBlock x:Name="TxtLogoSize" Grid.Column="2" Text="30%" Style="{DynamicResource TextLabel}" HorizontalAlignment="Right" VerticalAlignment="Center"
                               ToolTip="Phần trăm chiều rộng video; ảnh giữ nguyên tỷ lệ."/>
                    <TextBlock Grid.Row="1" Text="Độ mờ" Style="{DynamicResource TextMutedStyle}" VerticalAlignment="Center" Margin="0,12,0,0"/>
                    <Slider x:Name="SldLogoFade" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="95" Value="60" TickFrequency="1" IsSnapToTickEnabled="True"
                            SmallChange="1" LargeChange="5" Margin="0,12,0,0" AutomationProperties.Name="Độ mờ logo"/>
                    <TextBlock x:Name="TxtLogoFade" Grid.Row="1" Grid.Column="2" Text="60%" Style="{DynamicResource TextLabel}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,12,0,0"/>
                    <TextBlock Grid.Row="2" Text="Chuyển động" Style="{DynamicResource TextMutedStyle}" VerticalAlignment="Center" Margin="0,14,0,0"/>
                    <ComboBox x:Name="CmbLogoMode" Grid.Row="2" Grid.Column="1" SelectedIndex="0" Margin="0,14,0,0" HorizontalAlignment="Left" Width="240"
                              AutomationProperties.Name="Chuyển động logo">
                      <ComboBoxItem Content="Tự do · di chuyển"/>
                      <ComboBoxItem Content="Cố định · đứng yên"/>
                    </ComboBox>
                    <TextBlock x:Name="TxtLogoMotionHint" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0" Style="{DynamicResource TextCaption}" TextWrapping="Wrap"
                               Text="Tự do: logo di chuyển khắp khung. Chọn Cố định để đặt vị trí (góc, giữa hoặc kéo thả tùy chỉnh)."/>
                    <StackPanel x:Name="PanelLogoPosition" Grid.Row="3" Grid.ColumnSpan="3" Orientation="Horizontal" Visibility="Collapsed" Margin="0,12,0,0">
                      <TextBlock Text="Vị trí" Style="{DynamicResource TextMutedStyle}" VerticalAlignment="Center" Width="110"/>
                      <ComboBox x:Name="CmbLogoPosition" SelectedIndex="3" Width="240" IsEnabled="False" AutomationProperties.Name="Vị trí logo">
                        <ComboBoxItem Content="Trên trái"/><ComboBoxItem Content="Trên phải"/>
                        <ComboBoxItem Content="Dưới trái"/><ComboBoxItem Content="Dưới phải"/><ComboBoxItem Content="Giữa"/>
                        <ComboBoxItem Content="Tùy chỉnh (kéo thả)" ToolTip="Vị trí và kích thước do bạn kéo thả trên khung xem trước."/>
                      </ComboBox>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>

              <!-- GIF -->
              <Border Style="{DynamicResource Card}" Margin="0,0,0,16">
                <StackPanel>
                  <CheckBox x:Name="ChkGif" Content="Chèn GIF" IsChecked="False" FontFamily="Segoe UI Semibold" FontSize="16" Margin="0,0,0,12"/>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="64"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="52" Height="52" CornerRadius="8" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            HorizontalAlignment="Left" Padding="4">
                      <Image x:Name="ImgGifPreview" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                      <TextBlock x:Name="TxtGifName" Text="Chưa chọn file GIF" Style="{DynamicResource TextLabel}" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                      <TextBox x:Name="TxtGifPath" IsReadOnly="True" FontSize="12" ToolTip="Đường dẫn file GIF (.gif) đã chọn." AutomationProperties.Name="Đường dẫn GIF"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                      <Button x:Name="BtnPickGif" Content="Chọn GIF…"/>
                    </StackPanel>
                  </Grid>
                  <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="110"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Kích thước" Style="{DynamicResource TextMutedStyle}" VerticalAlignment="Center"/>
                    <Slider x:Name="SldGifSize" Grid.Column="1" Minimum="5" Maximum="100" Value="20" TickFrequency="1" IsSnapToTickEnabled="True"
                            SmallChange="1" LargeChange="5" AutomationProperties.Name="Kích thước GIF"/>
                    <TextBlock x:Name="TxtGifSize" Grid.Column="2" Text="20%" Style="{DynamicResource TextLabel}" HorizontalAlignment="Right" VerticalAlignment="Center"
                               ToolTip="Phần trăm chiều rộng video."/>
                    <TextBlock Grid.Row="1" Text="Vị trí" Style="{DynamicResource TextMutedStyle}" VerticalAlignment="Center" Margin="0,14,0,0"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,14,0,0">
                      <ComboBox x:Name="CmbGifPosition" SelectedIndex="1" Width="240" Margin="0,0,8,0" AutomationProperties.Name="Vị trí GIF">
                        <ComboBoxItem Content="Trên trái"/><ComboBoxItem Content="Trên phải"/>
                        <ComboBoxItem Content="Dưới trái"/><ComboBoxItem Content="Dưới phải"/><ComboBoxItem Content="Giữa"/>
                        <ComboBoxItem Content="Tùy chỉnh (kéo thả)" ToolTip="Vị trí và kích thước do bạn kéo thả trên khung xem trước."/>
                      </ComboBox>
                      <Button x:Name="BtnGifFullFrame" Content="Phủ đầy khung" ToolTip="Kéo giãn GIF phủ kín khung xem trước và video."/>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>

              <!-- Lop dang chinh + ap dung -->
              <Border Style="{DynamicResource Card}">
                <StackPanel>
                  <TextBlock Text="Chỉnh trên khung xem trước" Style="{DynamicResource TextHeading}"/>
                  <TextBlock Text="Kéo để di chuyển; kéo cạnh hoặc góc để đổi kích thước; lăn chuột trên lớp để phóng to/thu nhỏ."
                             Style="{DynamicResource TextMutedStyle}" Margin="0,4,0,12"/>
                  <WrapPanel>
                    <TextBlock Text="Lớp đang chỉnh" Style="{DynamicResource TextMutedStyle}" VerticalAlignment="Center" Margin="0,0,12,8"/>
                    <Button x:Name="BtnSelectLogo" Content="Logo" Margin="0,0,8,8" IsEnabled="False" ToolTip="Đưa logo lên trước để kéo hoặc chỉnh kích thước."/>
                    <Button x:Name="BtnSelectGif" Content="GIF" Margin="0,0,16,8" IsEnabled="False" ToolTip="Đưa GIF lên trước để kéo hoặc chỉnh kích thước."/>
                    <Button x:Name="BtnReedit" Style="{DynamicResource BtnPrimary}" Margin="0,0,0,8" IsEnabled="False"
                            ToolTip="Dùng lại video gốc sạch và âm thanh đã lưu để áp dụng logo/GIF mới, không tải hoặc ghi âm lại.">
                      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE70F;" Style="{DynamicResource Icon}" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="Áp dụng lên video đang xem (sửa lại)"/></StackPanel>
                    </Button>
                  </WrapPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <!-- ================================================= HANG DOI -->
        <Grid x:Name="ViewQueue" Visibility="Collapsed" Margin="24,20,24,16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Hàng đợi" Style="{DynamicResource TextTitle}"/>
            <TextBlock x:Name="TxtQueueHeader" Text="Mỗi link một dòng; chọn một dòng để xem chi tiết 7 bước." Style="{DynamicResource TextMutedStyle}" Margin="0,4,0,0"/>
          </StackPanel>
          <Border Grid.Row="1" Style="{DynamicResource Card}" Padding="8">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <!-- tieu de cot -->
              <Grid Margin="8,4,8,8" TextElement.Foreground="{DynamicResource TextMuted}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="40"/>
                  <ColumnDefinition Width="190"/>
                  <ColumnDefinition Width="140"/>
                  <ColumnDefinition Width="70"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="#" Style="{DynamicResource TextCaption}"/>
