                    <TextBlock x:Name="TxtAboutVersion" Text="Phiên bản" Style="{DynamicResource TextMutedStyle}" Margin="0,4,0,8"/>
                    <TextBlock Style="{DynamicResource TextBody}"
                               Text="Tải video Facebook kèm bản lồng tiếng Meta AI: chọn tiếng Việt trên ứng dụng Facebook Android, thu âm thanh, ghép với phần hình chất lượng cao và chèn logo/GIF thương hiệu."/>
                  </StackPanel>
                </Border>
                <Border Style="{DynamicResource Card}" Margin="0,0,0,16">
                  <StackPanel>
                    <TextBlock Text="Phím tắt" Style="{DynamicResource TextHeading}" Margin="0,0,0,8"/>
                    <TextBlock Style="{DynamicResource TextMutedStyle}" LineHeight="22"
                               Text="Ctrl+Enter: bắt đầu · Esc: dừng (có xác nhận) · Ctrl+1…5: chuyển trang&#x0a;Space: phát/tạm dừng · ← / →: tua 3 giây · T: đổi âm thanh xem trước&#x0a;Ctrl+C: copy video đang xem · Ctrl+R: ghi âm lại · Shift+Delete: xóa video đang xem"/>
                  </StackPanel>
                </Border>
                <Border Style="{DynamicResource Card}">
                  <StackPanel>
                    <TextBlock Text="Giấy phép bên thứ ba" Style="{DynamicResource TextHeading}" Margin="0,0,0,8"/>
                    <TextBlock Style="{DynamicResource TextMutedStyle}" LineHeight="22"
                               Text="Các công cụ sau được tải về thư mục tools và dùng theo giấy phép của dự án gốc:&#x0a;• Android Platform Tools (ADB) — Google, Apache License 2.0&#x0a;• scrcpy — Genymobile, Apache License 2.0&#x0a;• FFmpeg / ffprobe — FFmpeg project, LGPL/GPL tùy bản build&#x0a;• yt-dlp — The Unlicense&#x0a;• whisper.cpp và model Whisper — MIT License (tùy chọn)&#x0a;Biểu tượng giao diện dùng phông Segoe Fluent Icons / Segoe MDL2 Assets có sẵn trong Windows."/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Grid>

      <!-- ===================================================== cot xem truoc -->
      <Border x:Name="PreviewPane" Grid.Column="2" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0"
              Padding="16,16,16,12" Visibility="Collapsed">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="False">
            <TextBlock Text="Xem trước" Style="{DynamicResource TextHeading}" VerticalAlignment="Center"/>
            <Border x:Name="BadgeRes" DockPanel.Dock="Right" Style="{DynamicResource Badge}" Background="{DynamicResource AccentSubtle}" Visibility="Collapsed">
              <TextBlock x:Name="TxtRes" Text="1080x1920" FontSize="12" Foreground="{DynamicResource Accent}"/>
            </Border>
          </DockPanel>
          <Border DockPanel.Dock="Top" Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="3"
                  HorizontalAlignment="Left" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="BtnTrackB" Style="{DynamicResource SegButton}" GroupName="PreviewTrack" Content="Bản lồng tiếng" IsChecked="True" Padding="10,4"
                           ToolTip="Phát video hoàn chỉnh với âm thanh đã thu từ Android"/>
              <RadioButton x:Name="BtnTrackA" Style="{DynamicResource SegButton}" GroupName="PreviewTrack" Content="Âm thanh tách" Padding="10,4"
                           ToolTip="Nghe riêng âm thanh lồng tiếng đã tách và chuẩn hóa"/>
            </StackPanel>
          </Border>

          <!-- review: hanh dong video dang xem -->
          <StackPanel x:Name="PanelRev" DockPanel.Dock="Bottom" Visibility="Collapsed" Margin="0,10,0,0">
            <TextBlock x:Name="TxtRev" Style="{DynamicResource TextCaption}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
            <Button x:Name="BtnCopyReup" Style="{DynamicResource BtnPrimary}" HorizontalAlignment="Stretch" Margin="0,0,0,8" ToolTip="Copy file vào clipboard để dán (Ctrl+V) khi đăng">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C8;" Style="{DynamicResource Icon}" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="Copy để đăng"/></StackPanel>
            </Button>
            <UniformGrid Columns="3">
              <Button x:Name="BtnRedo" Margin="0,0,4,0" ToolTip="Ghi âm lại video này (Ctrl+R)" AutomationProperties.Name="Ghi âm lại">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE720;" Style="{DynamicResource Icon}" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="Ghi lại"/></StackPanel>
              </Button>
              <Button x:Name="BtnFolder" Margin="4,0,4,0" ToolTip="Mở thư mục xuất" AutomationProperties.Name="Mở thư mục xuất">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" Style="{DynamicResource Icon}" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="Thư mục"/></StackPanel>
              </Button>
              <Button x:Name="BtnDeleteCurrent" Style="{DynamicResource BtnDanger}" Margin="4,0,0,0" ToolTip="Xóa video đang xem (Shift+Delete)" AutomationProperties.Name="Xóa video đang xem">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{DynamicResource Icon}" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="Xóa"/></StackPanel>
              </Button>
            </UniformGrid>
          </StackPanel>

          <!-- dieu khien phat -->
          <StackPanel x:Name="PanelPlay" DockPanel.Dock="Bottom" Visibility="Collapsed" Margin="0,10,0,0">
            <Slider x:Name="Seek" IsMoveToPointEnabled="False" ToolTip="Bấm hoặc kéo để tua video" AutomationProperties.Name="Thanh tua video"/>
            <DockPanel Margin="0,6,0,0" LastChildFill="False">
              <Button x:Name="BtnPlay" Style="{DynamicResource BtnPlayToggle}" Content="Phát" MinWidth="110" AutomationProperties.Name="Phát hoặc tạm dừng"/>
              <TextBlock x:Name="TxtTime" Text="0:00 / 0:00" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{DynamicResource TextMuted}"
                         VerticalAlignment="Center" Margin="12,0,0,0"/>
              <Button x:Name="BtnOpenExt" DockPanel.Dock="Right" Style="{DynamicResource BtnIcon}" Content="&#xE8A7;" ToolTip="Mở bằng trình phát mặc định của Windows"
                      AutomationProperties.Name="Mở bằng trình phát ngoài"/>
            </DockPanel>
          </StackPanel>

          <!-- khung 9:16 -->
          <Border Background="{DynamicResource Surface0}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
            <Grid x:Name="ViewportGrid">
              <Border x:Name="PhoneFrame" HorizontalAlignment="Center" VerticalAlignment="Center" Width="300" Height="533"
                      Background="{DynamicResource MediaBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                <Grid x:Name="PlayerContainer" ClipToBounds="True">
                  <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" ScrubbingEnabled="True" Margin="0"/>
                  <!-- Khung mau 9:16 (chi trang Thuong hieu, khi chua co video): van keo tha logo/GIF duoc. -->
                  <Grid x:Name="PreviewSample" Visibility="Collapsed" IsHitTestVisible="False">
                    <Grid.Background>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                        <GradientStop Color="{DynamicResource Surface2Color}" Offset="0"/>
                        <GradientStop Color="{DynamicResource Surface0Color}" Offset="1"/>
                      </LinearGradientBrush>
                    </Grid.Background>
                    <Border Background="{DynamicResource Scrim}" CornerRadius="6" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock Text="Khung mẫu 9:16 · kéo logo/GIF để đặt vị trí" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                    </Border>
                  </Grid>
                  <Canvas x:Name="CanvasWatermark" ClipToBounds="True" Panel.ZIndex="10" Background="Transparent" Focusable="True">
                    <Grid x:Name="BoxLogoOverlay" Visibility="Collapsed" Cursor="SizeAll">
                      <Border x:Name="BorderLogoOverlay" BorderBrush="{DynamicResource OverlayLogo}" BorderThickness="1.5" CornerRadius="2"
                              Background="{DynamicResource HitTestFill}" SnapsToDevicePixels="True"/>
                      <Image x:Name="ImgVideoWatermark" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False" Visibility="Visible"/>
                      <Border x:Name="GripLogoResize" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="{DynamicResource OverlayLogo}" CornerRadius="3" Cursor="SizeNWSE" ToolTip="Kéo góc để chỉnh kích thước (hoặc lăn chuột)"/>
                      <Border x:Name="GripLogoResizeNW" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource OverlayLogo}" CornerRadius="3" Cursor="SizeNWSE" ToolTip="Kéo góc trên trái để chỉnh kích thước"/>
                      <Border x:Name="GripLogoResizeNE" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource OverlayLogo}" CornerRadius="3" Cursor="SizeNESW" ToolTip="Kéo góc trên phải để chỉnh kích thước"/>
                      <Border x:Name="GripLogoResizeSW" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="{DynamicResource OverlayLogo}" CornerRadius="3" Cursor="SizeNESW" ToolTip="Kéo góc dưới trái để chỉnh kích thước"/>
                      <Border x:Name="GripLogoResizeN" Width="24" Height="7" HorizontalAlignment="Center" VerticalAlignment="Top" Background="{DynamicResource OverlayLogo}" CornerRadius="3" Cursor="SizeNS" ToolTip="Kéo cạnh trên để chỉnh chiều cao"/>
                      <Border x:Name="GripLogoResizeS" Width="24" Height="7" HorizontalAlignment="Center" VerticalAlignment="Bottom" Background="{DynamicResource OverlayLogo}" CornerRadius="3" Cursor="SizeNS" ToolTip="Kéo cạnh dưới để chỉnh chiều cao"/>
                      <Border x:Name="GripLogoResizeW" Width="7" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource OverlayLogo}" CornerRadius="3" Cursor="SizeWE" ToolTip="Kéo cạnh trái để chỉnh chiều rộng"/>
                      <Border x:Name="GripLogoResizeE" Width="7" Height="24" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource OverlayLogo}" CornerRadius="3" Cursor="SizeWE" ToolTip="Kéo cạnh phải để chỉnh chiều rộng"/>
                    </Grid>
                    <Grid x:Name="BoxGifOverlay" Visibility="Collapsed" Cursor="SizeAll">
                      <Border x:Name="BorderGifOverlay" BorderBrush="{DynamicResource OverlayGif}" BorderThickness="1.5" CornerRadius="2"
                              Background="{DynamicResource HitTestFill}" SnapsToDevicePixels="True"/>
                      <Image x:Name="ImgVideoGif" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False" Visibility="Collapsed"/>
                      <Border x:Name="GripGifResize" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="{DynamicResource OverlayGif}" CornerRadius="3" Cursor="SizeNWSE" ToolTip="Kéo góc để chỉnh kích thước (hoặc lăn chuột)"/>
                      <Border x:Name="GripGifResizeNW" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource OverlayGif}" CornerRadius="3" Cursor="SizeNWSE" ToolTip="Kéo góc trên trái để chỉnh kích thước"/>
                      <Border x:Name="GripGifResizeNE" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource OverlayGif}" CornerRadius="3" Cursor="SizeNESW" ToolTip="Kéo góc trên phải để chỉnh kích thước"/>
                      <Border x:Name="GripGifResizeSW" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="{DynamicResource OverlayGif}" CornerRadius="3" Cursor="SizeNESW" ToolTip="Kéo góc dưới trái để chỉnh kích thước"/>
                      <Border x:Name="GripGifResizeN" Width="24" Height="7" HorizontalAlignment="Center" VerticalAlignment="Top" Background="{DynamicResource OverlayGif}" CornerRadius="3" Cursor="SizeNS" ToolTip="Kéo cạnh trên để chỉnh chiều cao"/>
                      <Border x:Name="GripGifResizeS" Width="24" Height="7" HorizontalAlignment="Center" VerticalAlignment="Bottom" Background="{DynamicResource OverlayGif}" CornerRadius="3" Cursor="SizeNS" ToolTip="Kéo cạnh dưới để chỉnh chiều cao"/>
                      <Border x:Name="GripGifResizeW" Width="7" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource OverlayGif}" CornerRadius="3" Cursor="SizeWE" ToolTip="Kéo cạnh trái để chỉnh chiều rộng"/>
                      <Border x:Name="GripGifResizeE" Width="7" Height="24" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource OverlayGif}" CornerRadius="3" Cursor="SizeWE" ToolTip="Kéo cạnh phải để chỉnh chiều rộng"/>
                    </Grid>
                  </Canvas>
                  <Border x:Name="BadgePreviewMode" Background="{DynamicResource Scrim}" CornerRadius="6" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Top"
                          Margin="0,10,0,0" Panel.ZIndex="25" Visibility="Collapsed" Cursor="Hand" ToolTip="Bấm để quay lại video hoàn chỉnh">
                    <TextBlock x:Name="TxtPreviewMode" Text="Xem trước chỉnh sửa · video gốc sạch" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                  </Border>
                  <StackPanel x:Name="TxtNoVid" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="12" Panel.ZIndex="5">
                    <TextBlock Text="&#xE714;" Style="{DynamicResource Icon}" FontSize="34" Foreground="{DynamicResource TextSubtle}" Margin="0,0,0,10"/>
                    <TextBlock Text="Chưa có video để xem" Foreground="{DynamicResource TextMuted}" FontFamily="Segoe UI Semibold" FontSize="14" TextWrapping="Wrap" TextAlignment="Center"/>
                    <TextBlock Text="Chọn một video trong Kho hoặc chạy hàng đợi; video hoàn tất hiển thị theo khung dọc 9:16."
                               Foreground="{DynamicResource TextSubtle}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>
          </Border>
        </DockPanel>
      </Border>
    </Grid>

    <!-- ===================================================== thanh hanh dong co dinh -->
    <Border Grid.Row="2" x:Name="ActionBar" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="16,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="BtnStart" Style="{DynamicResource BtnPrimary}" MinWidth="150" Height="40" FontSize="14" Padding="18,0"
                ToolTip="Bắt đầu xử lý danh sách link (Ctrl+Enter)" AutomationProperties.Name="Bắt đầu hoặc dừng">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="TxtStartGlyph" Text="&#xE768;" Style="{DynamicResource Icon}" FontSize="14" Margin="0,0,10,0" Foreground="{DynamicResource TextOnAccent}"/>
            <AccessText x:Name="TxtStartLabel" Text="_Bắt đầu" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Grid Grid.Column="1" Margin="20,0,20,0" VerticalAlignment="Center">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <DockPanel LastChildFill="True">
            <TextBlock x:Name="TxtProgress" DockPanel.Dock="Left" Text="0/0" FontFamily="Segoe UI Semibold" FontSize="13" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="TxtStat" DockPanel.Dock="Right" Text="" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="12,0,0,0"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
            <TextBlock x:Name="TxtCurrentItem" Text="Sẵn sàng" FontSize="13" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          </DockPanel>
          <ProgressBar x:Name="Bar" Grid.Row="1" Margin="0,8,0,0" Minimum="0" Maximum="1" Value="0"/>
        </Grid>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Style="{DynamicResource Badge}" Background="{DynamicResource SuccessSubtle}" Margin="0,0,6,0" ToolTip="Đã lưu">
            <TextBlock x:Name="TxtCountSaved" Text="0 đã lưu" FontSize="12" Foreground="{DynamicResource Success}"/>
          </Border>
          <Border Style="{DynamicResource Badge}" Background="{DynamicResource WarningSubtle}" Margin="0,0,6,0" ToolTip="Bị loại (không có bản lồng tiếng Việt)">
            <TextBlock x:Name="TxtCountRejected" Text="0 bị loại" FontSize="12" Foreground="{DynamicResource Warning}"/>
          </Border>
          <Border Style="{DynamicResource Badge}" Margin="0,0,6,0" ToolTip="Bỏ qua (đã loại trước hoặc đã có trong kho)">
            <TextBlock x:Name="TxtCountSkipped" Text="0 bỏ qua" FontSize="12" Foreground="{DynamicResource Neutral}"/>
          </Border>
          <Border Style="{DynamicResource Badge}" Background="{DynamicResource DangerSubtle}" ToolTip="Lỗi">
            <TextBlock x:Name="TxtCountFailed" Text="0 lỗi" FontSize="12" Foreground="{DynamicResource Danger}"/>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===================================================== thong bao (goc duoi phai) -->
    <StackPanel x:Name="NotificationHost" Grid.Row="0" Grid.RowSpan="3" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,20,84" Width="380" Panel.ZIndex="100"/>
  </Grid>
</Window>
