          <!-- thanh loc: cac pill bo tron, tu xuong dong khi hep -->
          <WrapPanel x:Name="PanelLibFilters" Grid.Row="1" Margin="0,0,0,4">
            <Grid Width="240" Margin="0,0,10,8">
              <TextBox x:Name="TxtGallerySearch" Padding="40,6,14,6" AutomationProperties.Name="Tìm theo ID">
                <TextBox.Template>
                  <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" CornerRadius="24">
                      <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ink}"/></Trigger>
                      <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentPressed}"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </TextBox.Template>
              </TextBox>
              <TextBlock Text="&#xE721;" Style="{DynamicResource Icon}" FontSize="15" HorizontalAlignment="Left" Margin="16,0,0,0" IsHitTestVisible="False"/>
              <TextBlock x:Name="TxtGallerySearchHint" Text="Tìm theo ID…" Foreground="{DynamicResource TextSubtle}" FontSize="15" FontWeight="SemiBold" Margin="42,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
            <ComboBox x:Name="CmbDateFilter" Width="160" Margin="0,0,10,8" SelectedIndex="0" AutomationProperties.Name="Lọc theo ngày">
              <ComboBoxItem Content="Tất cả ngày"/>
              <ComboBoxItem Content="Hôm nay"/>
              <ComboBoxItem Content="Hôm qua"/>
              <ComboBoxItem Content="7 ngày qua"/>
              <ComboBoxItem Content="Chọn ngày…"/>
            </ComboBox>
            <ComboBox x:Name="CmbFilterSpecificDate" Width="200" Margin="0,0,10,8" Visibility="Collapsed" AutomationProperties.Name="Ngày cụ thể"/>
            <ComboBox x:Name="CmbKho" Width="340" MaxWidth="340" Margin="0,0,10,8" AutomationProperties.Name="Chọn kho" ToolTip="Chọn kho video; số liệu: chờ đăng · đã hẹn · đã đăng"/>
            <Button x:Name="BtnKhoManage" Margin="0,0,10,8" ToolTip="Thêm, đổi tên, xóa kho; mẫu caption; thêm video từ thư mục" AutomationProperties.Name="Quản lý kho">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{DynamicResource Icon}" FontSize="15" Margin="0,0,8,0"/><TextBlock Text="Quản lý kho" VerticalAlignment="Center"/></StackPanel>
            </Button>
            <StackPanel x:Name="PanelStatusTabs" Orientation="Horizontal" Margin="0,0,10,8" KeyboardNavigation.DirectionalNavigation="Cycle">
