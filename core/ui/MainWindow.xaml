            <ScrollViewer x:Name="ViewGeneral" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Margin="0,0,-6,0">
              <StackPanel Margin="0,0,10,0">
                <ContentControl Style="{DynamicResource StickerCard}" Margin="0,0,0,14" Padding="20,16">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                      <Border Style="{DynamicResource IconChip}" Background="{DynamicResource Peach}" Width="40" Height="40" CornerRadius="20" Margin="0,0,12,0">
                        <TextBlock Text="&#xE8D6;" Style="{DynamicResource Icon}" FontSize="16"/>
                      </Border>
                      <TextBlock Text="Đồng bộ âm thanh" Style="{DynamicResource TextHeading}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <CheckBox x:Name="ChkAllowOnsetSync" Style="{DynamicResource ToggleSwitch}" IsChecked="False"
                              AutomationProperties.Name="Cho phép đồng bộ theo âm thanh khi thiết bị không thu được hình">
                      <StackPanel>
                        <TextBlock Text="Cho phép đồng bộ theo âm thanh khi thiết bị không thu được hình" FontWeight="ExtraBold" FontSize="16" TextWrapping="Wrap"/>
                        <TextBlock Text="Kém chính xác, có thể lệch 0,5–1,2 s. Mặc định tắt: video không thu được hình sẽ báo chưa xác nhận để bạn thử lại."
                                   Style="{DynamicResource TextMutedStyle}" Margin="0,4,0,0"/>
                        <Border Background="{DynamicResource WarningSubtle}" BorderBrush="{DynamicResource PeachLine}" BorderThickness="2" CornerRadius="12" Padding="10,6" Margin="0,8,0,0" HorizontalAlignment="Left">
                          <TextBlock x:Name="TxtOnsetSyncNote" Style="{DynamicResource TextMutedStyle}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"
                                     Text="Chỉ dùng khi thiết bị không ghi được hình; video quá tối/ít chuyển động mà không khớp được hình vẫn sẽ không xuất."/>
                        </Border>
                      </StackPanel>
                    </CheckBox>
                  </StackPanel>
                </ContentControl>
                <ContentControl Style="{DynamicResource StickerCard}" Padding="20,16">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                      <Border Style="{DynamicResource IconChip}" Background="{DynamicResource Mint}" Width="40" Height="40" CornerRadius="20" Margin="0,0,12,0">
                        <TextBlock Text="&#xE74C;" Style="{DynamicResource Icon}" FontSize="16"/>
                      </Border>
                      <TextBlock Text="Lưu trữ" Style="{DynamicResource TextHeading}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Style="{DynamicResource TextMutedStyle}" FontSize="15"
                               Text="Thư mục xuất chỉ hiện file hoàn chỉnh (-3). Video gốc (-1) và âm thanh (-2) được cất trong thư mục ẩn .cache để sửa lại logo/GIF không cần tải lại."/>
                    <Border Style="{DynamicResource CardInset}" Background="{DynamicResource MintSoft}" Margin="0,12,0,12" Padding="14,10">
                      <TextBlock x:Name="TxtCacheInfo" Text="Đang đọc dung lượng…" FontWeight="Bold" FontSize="14" TextWrapping="Wrap"/>
                    </Border>
                    <WrapPanel>
                      <Button x:Name="BtnCleanLegacy" Style="{DynamicResource BtnButter}" Margin="0,0,10,8" AutomationProperties.Name="Dọn file trung gian cũ"
                              ToolTip="File -1/-2 của bản cũ đang nằm lẫn ở thư mục xuất: chuyển vào .cache hoặc xóa.">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{DynamicResource Icon}" FontSize="15" Margin="0,0,8,0"/><TextBlock Text="Dọn file trung gian cũ…" VerticalAlignment="Center"/></StackPanel>
                      </Button>
                      <Button x:Name="BtnClearCache" Style="{DynamicResource BtnDanger}" Margin="0,0,10,8" AutomationProperties.Name="Dọn cache sửa lại"
                              ToolTip="Xóa toàn bộ .cache: video cũ sẽ không sửa lại logo/GIF được nữa.">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{DynamicResource Icon}" FontSize="15" Margin="0,0,8,0"/><TextBlock Text="Dọn cache sửa lại…" VerticalAlignment="Center"/></StackPanel>
                      </Button>
                    </WrapPanel>
                  </StackPanel>
                </ContentControl>
              </StackPanel>
            </ScrollViewer>

            <!-- Nhat ky -->
            <ContentControl x:Name="ViewLogs" Visibility="Collapsed" Style="{DynamicResource StickerCard}" Padding="0">
              <DockPanel>
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource InkFaint}" BorderThickness="0,0,0,2" Padding="18,12">
                  <DockPanel LastChildFill="False">
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="Nhật ký kỹ thuật (không dấu)" Style="{DynamicResource TextHeading}" ToolTip="Đây là nhật ký kỹ thuật của engine: viết không dấu để dễ gửi/tra cứu; câu thông báo cho người dùng nằm ở thẻ Hàng đợi."/>
                      <TextBlock x:Name="TxtLogPath" Text="" Style="{DynamicResource TextCaption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button x:Name="BtnCopyLog" Style="{DynamicResource BtnSky}" Margin="0,0,10,0" ToolTip="Sao chép toàn bộ nhật ký" AutomationProperties.Name="Sao chép nhật ký">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C8;" Style="{DynamicResource Icon}" FontSize="15" Margin="0,0,8,0"/><TextBlock Text="Sao chép" VerticalAlignment="Center"/></StackPanel>
                      </Button>
                      <Button x:Name="BtnOpenLogFolder" Margin="0,0,10,0" ToolTip="Mở thư mục logs" AutomationProperties.Name="Mở thư mục nhật ký">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" Style="{DynamicResource Icon}" FontSize="15" Margin="0,0,8,0"/><TextBlock Text="Thư mục logs" VerticalAlignment="Center"/></StackPanel>
                      </Button>
                      <Button x:Name="BtnClearLog" Style="{DynamicResource BtnGhost}" ToolTip="Xóa nhật ký đang hiển thị (file log vẫn giữ)" AutomationProperties.Name="Xóa nhật ký hiển thị">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{DynamicResource Icon}" FontSize="15" Margin="0,0,8,0"/><TextBlock Text="Xóa" VerticalAlignment="Center"/></StackPanel>
                      </Button>
                    </StackPanel>
                  </DockPanel>
                </Border>
                <TextBox x:Name="TxtLog" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Style="{DynamicResource TextBoxMono}"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Background="Transparent"
                         Padding="18,12" FontSize="13" AutomationProperties.Name="Nhật ký"/>
              </DockPanel>
            </ContentControl>

            <!-- Cap nhat -->
            <StackPanel x:Name="ViewUpdate" Visibility="Collapsed">
              <ContentControl Style="{DynamicResource StickerCard}" Padding="20,16">
                <DockPanel>
                  <Button x:Name="BtnUpdate" DockPanel.Dock="Right" Style="{DynamicResource BtnPrimary}" VerticalAlignment="Center" AutomationProperties.Name="Kiểm tra bản mới">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE895;" Style="{DynamicResource Icon}" FontSize="15" Margin="0,0,8,0"/><TextBlock x:Name="TxtUpdateButton" Text="Kiểm tra bản mới"/></StackPanel>
                  </Button>
                  <Border DockPanel.Dock="Left" Style="{DynamicResource IconChip}" Background="{DynamicResource Lavender}" Width="44" Height="44" CornerRadius="22" Margin="0,0,14,0" VerticalAlignment="Top">
                    <TextBlock Text="&#xE895;" Style="{DynamicResource Icon}"/>
                  </Border>
                  <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Cập nhật" Style="{DynamicResource TextHeading}"/>
                    <TextBlock x:Name="TxtUpdateInfo" Text="Phiên bản hiện tại" Style="{DynamicResource TextMutedStyle}" Margin="0,4,0,0"/>
                  </StackPanel>
                </DockPanel>
              </ContentControl>
            </StackPanel>

            <!-- Gioi thieu -->
            <ScrollViewer x:Name="ViewAbout" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Margin="0,0,-6,0">
              <StackPanel Margin="0,0,10,0">
                <ContentControl Style="{DynamicResource StickerCard}" Background="{DynamicResource PinkSoft}" Margin="0,0,0,14" Padding="20,16">
                  <DockPanel>
                    <Image DockPanel.Dock="Left" Source="{DynamicResource MascotCloud}" Width="84" Height="66" Margin="0,0,16,0" VerticalAlignment="Top"/>
                    <StackPanel>
                      <TextBlock Text="Kid FB.Y" Style="{DynamicResource TextHeading}" FontSize="24"/>
                      <TextBlock x:Name="TxtAboutVersion" Text="Phiên bản" Style="{DynamicResource TextMutedStyle}" Margin="0,2,0,8"/>
                      <TextBlock Style="{DynamicResource TextBody}"
                                 Text="Tải video Facebook kèm bản lồng tiếng Meta AI: chọn tiếng Việt trên ứng dụng Facebook Android, thu âm thanh, ghép với phần hình chất lượng cao và chèn logo/GIF thương hiệu."/>
                    </StackPanel>
                  </DockPanel>
                </ContentControl>
                <ContentControl Style="{DynamicResource StickerCard}" Margin="0,0,0,14" Padding="20,16">
                  <StackPanel>
                    <TextBlock Text="Phím tắt" Style="{DynamicResource TextHeading}" Margin="0,0,0,8"/>
                    <TextBlock Style="{DynamicResource TextMutedStyle}" FontSize="15" LineHeight="24"
                               Text="Ctrl+Enter: bắt đầu · Esc: thoát Xem lớn, hoặc dừng (hỏi lại nếu còn video chờ) · Ctrl+1…5: chuyển trang&#x0a;Space: phát/tạm dừng · ← / →: tua 3 giây · T: đổi âm thanh xem trước · F: Xem lớn (nhấp đúp thẻ Kho cũng được)&#x0a;Ctrl+C: sao chép video đang xem · Ctrl+R: ghi âm lại · Shift+Delete: xóa video đang xem"/>
                  </StackPanel>
                </ContentControl>
                <ContentControl Style="{DynamicResource StickerCard}" Padding="20,16">
                  <StackPanel>
                    <TextBlock Text="Giấy phép bên thứ ba" Style="{DynamicResource TextHeading}" Margin="0,0,0,8"/>
                    <TextBlock Style="{DynamicResource TextMutedStyle}" FontSize="15" LineHeight="24"
                               Text="Các công cụ sau được tải về thư mục tools và dùng theo giấy phép của dự án gốc:&#x0a;• Android Platform Tools (ADB) — Google, Apache License 2.0&#x0a;• scrcpy — Genymobile, Apache License 2.0&#x0a;• FFmpeg / ffprobe — FFmpeg project, LGPL/GPL tùy bản build&#x0a;• yt-dlp — The Unlicense&#x0a;• whisper.cpp và model Whisper — MIT License (tùy chọn)&#x0a;Phông chữ Nunito — The Nunito Project Authors, SIL Open Font License 1.1 (core\ui\fonts\OFL.txt).&#x0a;Phong cách giao diện lấy cảm hứng từ preset &quot;cute&quot; của baoyu-skills (Jim Liu, giấy phép MIT) và phông Nunito (OFL).&#x0a;Biểu tượng giao diện dùng phông Segoe Fluent Icons / Segoe MDL2 Assets có sẵn trong Windows; hình trang trí tự vẽ bằng vector."/>
                  </StackPanel>
                </ContentControl>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Grid>

      <!-- ===================================================== cot xem truoc: khung video to, thanh dieu khien phu tren video -->
      <Grid x:Name="PreviewPane" Grid.Column="2" Margin="0,4,16,10" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition x:Name="RowPreviewDeco" Height="24"/>
          <RowDefinition Height="*"/>
          <RowDefinition x:Name="RowPreviewBar" Height="56"/>
        </Grid.RowDefinitions>

        <!-- trang tri nho NGOAI khung video (toi da 24 px) -->
        <StackPanel x:Name="PreviewDeco" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
          <Image Source="{DynamicResource DecoHeart}" Width="16" Height="15" Margin="0,0,10,0"/>
          <Image Source="{DynamicResource DecoSparkles}" Width="28" Height="22"/>
          <Image Source="{DynamicResource DecoStar}" Width="16" Height="16" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- khung video 9:16 (hoac ty le that): vien sticker 2 px, bo 20, bong lech 4 px -->
        <Grid x:Name="ViewportGrid" Grid.Row="1">
          <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Margin="4,4,0,0" CornerRadius="20" Background="{DynamicResource StickerShadow}"/>
            <Border x:Name="PhoneShell" Margin="0,0,4,4" CornerRadius="20" BorderBrush="{DynamicResource InkStrong}" BorderThickness="2" Background="{DynamicResource MediaBackground}">
              <Border x:Name="PhoneFrame" Width="270" Height="480" Background="{DynamicResource MediaBackground}" BorderThickness="0" CornerRadius="18" ClipToBounds="True">
                <Grid x:Name="PlayerContainer" ClipToBounds="True" Background="{DynamicResource MediaBackground}">
                  <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" ScrubbingEnabled="True" Margin="0"/>
                  <!-- Khung mau 9:16 (chi trang Thuong hieu, khi chua co video): van keo tha logo/GIF duoc. -->
                  <Grid x:Name="PreviewSample" Visibility="Collapsed" IsHitTestVisible="False">
                    <Grid.Background>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                        <GradientStop Color="#FFFFF5F7" Offset="0"/>
                        <GradientStop Color="#FFF6EFFE" Offset="0.55"/>
                        <GradientStop Color="#FFE7F5FA" Offset="1"/>
                      </LinearGradientBrush>
                    </Grid.Background>
                    <Rectangle RadiusX="14" RadiusY="14" Margin="10" Stroke="{DynamicResource LavenderLine}" StrokeThickness="2" StrokeDashArray="1 3" StrokeDashCap="Round"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="14">
                      <Image Source="{DynamicResource MascotCloud}" Width="64" Height="50" Opacity="0.9"/>
                      <TextBlock Text="Khung mẫu 9:16&#x0a;kéo logo/GIF nhé" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="210" Margin="0,8,0,0"/>
                    </StackPanel>
                  </Grid>
                  <Canvas x:Name="CanvasWatermark" ClipToBounds="True" Panel.ZIndex="10" Background="Transparent" Focusable="True">
                    <Grid x:Name="BoxLogoOverlay" Visibility="Collapsed" Cursor="SizeAll">
                      <Border x:Name="BorderLogoOverlay" BorderBrush="{DynamicResource OverlayLogo}" BorderThickness="2" CornerRadius="4"
                              Background="{DynamicResource HitTestFill}" SnapsToDevicePixels="True"/>
                      <Image x:Name="ImgVideoWatermark" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False" Visibility="Visible"/>
                      <Border x:Name="GripLogoResize" Width="13" Height="13" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="{DynamicResource OverlayLogo}" BorderBrush="White" BorderThickness="1.5" CornerRadius="7" Cursor="SizeNWSE" ToolTip="Kéo góc để chỉnh kích thước (hoặc lăn chuột)"/>
                      <Border x:Name="GripLogoResizeNW" Width="13" Height="13" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource OverlayLogo}" BorderBrush="White" BorderThickness="1.5" CornerRadius="7" Cursor="SizeNWSE" ToolTip="Kéo góc trên trái để chỉnh kích thước"/>
                      <Border x:Name="GripLogoResizeNE" Width="13" Height="13" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource OverlayLogo}" BorderBrush="White" BorderThickness="1.5" CornerRadius="7" Cursor="SizeNESW" ToolTip="Kéo góc trên phải để chỉnh kích thước"/>
                      <Border x:Name="GripLogoResizeSW" Width="13" Height="13" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="{DynamicResource OverlayLogo}" BorderBrush="White" BorderThickness="1.5" CornerRadius="7" Cursor="SizeNESW" ToolTip="Kéo góc dưới trái để chỉnh kích thước"/>
                      <Border x:Name="GripLogoResizeN" Width="24" Height="8" HorizontalAlignment="Center" VerticalAlignment="Top" Background="{DynamicResource OverlayLogo}" CornerRadius="4" Cursor="SizeNS" ToolTip="Kéo cạnh trên để chỉnh chiều cao"/>
                      <Border x:Name="GripLogoResizeS" Width="24" Height="8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Background="{DynamicResource OverlayLogo}" CornerRadius="4" Cursor="SizeNS" ToolTip="Kéo cạnh dưới để chỉnh chiều cao"/>
                      <Border x:Name="GripLogoResizeW" Width="8" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource OverlayLogo}" CornerRadius="4" Cursor="SizeWE" ToolTip="Kéo cạnh trái để chỉnh chiều rộng"/>
                      <Border x:Name="GripLogoResizeE" Width="8" Height="24" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource OverlayLogo}" CornerRadius="4" Cursor="SizeWE" ToolTip="Kéo cạnh phải để chỉnh chiều rộng"/>
                    </Grid>
                    <Grid x:Name="BoxGifOverlay" Visibility="Collapsed" Cursor="SizeAll">
                      <Border x:Name="BorderGifOverlay" BorderBrush="{DynamicResource OverlayGif}" BorderThickness="2" CornerRadius="4"
                              Background="{DynamicResource HitTestFill}" SnapsToDevicePixels="True"/>
                      <Image x:Name="ImgVideoGif" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False" Visibility="Collapsed"/>
                      <Border x:Name="GripGifResize" Width="13" Height="13" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="{DynamicResource OverlayGif}" BorderBrush="White" BorderThickness="1.5" CornerRadius="7" Cursor="SizeNWSE" ToolTip="Kéo góc để chỉnh kích thước (hoặc lăn chuột)"/>
                      <Border x:Name="GripGifResizeNW" Width="13" Height="13" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource OverlayGif}" BorderBrush="White" BorderThickness="1.5" CornerRadius="7" Cursor="SizeNWSE" ToolTip="Kéo góc trên trái để chỉnh kích thước"/>
                      <Border x:Name="GripGifResizeNE" Width="13" Height="13" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource OverlayGif}" BorderBrush="White" BorderThickness="1.5" CornerRadius="7" Cursor="SizeNESW" ToolTip="Kéo góc trên phải để chỉnh kích thước"/>
                      <Border x:Name="GripGifResizeSW" Width="13" Height="13" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="{DynamicResource OverlayGif}" BorderBrush="White" BorderThickness="1.5" CornerRadius="7" Cursor="SizeNESW" ToolTip="Kéo góc dưới trái để chỉnh kích thước"/>
                      <Border x:Name="GripGifResizeN" Width="24" Height="8" HorizontalAlignment="Center" VerticalAlignment="Top" Background="{DynamicResource OverlayGif}" CornerRadius="4" Cursor="SizeNS" ToolTip="Kéo cạnh trên để chỉnh chiều cao"/>
                      <Border x:Name="GripGifResizeS" Width="24" Height="8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Background="{DynamicResource OverlayGif}" CornerRadius="4" Cursor="SizeNS" ToolTip="Kéo cạnh dưới để chỉnh chiều cao"/>
                      <Border x:Name="GripGifResizeW" Width="8" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource OverlayGif}" CornerRadius="4" Cursor="SizeWE" ToolTip="Kéo cạnh trái để chỉnh chiều rộng"/>
                      <Border x:Name="GripGifResizeE" Width="8" Height="24" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource OverlayGif}" CornerRadius="4" Cursor="SizeWE" ToolTip="Kéo cạnh phải để chỉnh chiều rộng"/>
                    </Grid>
                  </Canvas>

                  <!-- trang thai rong: nen hong nhat, vien cham, may mat cuoi nho (khong khoi nau) -->
                  <Grid x:Name="TxtNoVid" Panel.ZIndex="5" Background="{DynamicResource PinkSoft}">
                    <Rectangle RadiusX="14" RadiusY="14" Margin="10" Stroke="{DynamicResource PinkLine}" StrokeThickness="2" StrokeDashArray="1 3" StrokeDashCap="Round"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="18">
                      <Image x:Name="ImgNoVid" Source="{DynamicResource MascotCloud}" Width="64" Height="50" Margin="0,0,0,8"/>
                      <TextBlock x:Name="TxtNoVidTitle" Text="Chưa có video để xem" Foreground="{DynamicResource TextPrimary}" FontWeight="ExtraBold" FontSize="15" TextWrapping="Wrap" TextAlignment="Center"/>
                      <TextBlock x:Name="TxtNoVidText" Text="Chọn một video trong Kho hoặc chạy hàng đợi; video hoàn tất hiện ở khung dọc 9:16."
                                 Foreground="{DynamicResource TextMuted}" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                  </Grid>

                  <!-- chip do phan giai (goc tren trai) + nut Xem lon (goc tren phai): PHU len video -->
                  <Border x:Name="BadgeRes" Height="32" CornerRadius="16" Background="{DynamicResource SkySoft}" BorderBrush="{DynamicResource SkyLine}" BorderThickness="2" Padding="10,0"
                          HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0" Panel.ZIndex="30" Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock x:Name="TxtRes" Text="1080x1920" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                  </Border>
                  <Button x:Name="BtnPreviewExpand" Style="{DynamicResource BtnOverlayIcon}" Content="&#xE740;" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0" Panel.ZIndex="31"
                          ToolTip="Xem lớn (F)" AutomationProperties.Name="Xem lớn"/>
                  <Border x:Name="BadgePreviewMode" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource Ink}" BorderThickness="2" CornerRadius="16" Height="32" Padding="12,0"
                          HorizontalAlignment="Center" VerticalAlignment="Top" Margin="8,50,8,0" Panel.ZIndex="25" Visibility="Collapsed" Cursor="Hand" ToolTip="Bấm để quay lại video hoàn chỉnh">
                    <TextBlock x:Name="TxtPreviewMode" Text="Xem trước chỉnh sửa · video gốc sạch" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                  </Border>

                  <!-- thanh dieu khien phu o day video: cao 44, nen nau mo 55%, chu trang, tu an sau 2 s -->
                  <Grid x:Name="PlayBarHost" VerticalAlignment="Bottom" Height="44" Panel.ZIndex="30">
                    <Border x:Name="PanelPlay" Background="#8C4A3428" Visibility="Collapsed">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnPlay" Style="{DynamicResource BtnPlayOverlay}" Content="Phát" AutomationProperties.Name="Phát hoặc tạm dừng" ToolTip="Phát / tạm dừng (Space)"/>
                        <Slider x:Name="Seek" Grid.Column="1" Style="{DynamicResource SeekSlider}" IsMoveToPointEnabled="False" Margin="2,0,6,0" ToolTip="Bấm hoặc kéo để tua video" AutomationProperties.Name="Thanh tua video"/>
                        <TextBlock x:Name="TxtTime" Grid.Column="2" Text="0:00 / 0:00" FontFamily="{DynamicResource FontMono}" FontSize="13" Foreground="White"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                      </Grid>
                    </Border>
                  </Grid>
                </Grid>
              </Border>
            </Border>
          </Grid>
        </Grid>

        <!-- MOT hang 48 px duoi video: [Long tieng | Am thanh tach] · Sao chep de dang · ⋯ -->
        <Grid x:Name="PanelRev" Grid.Row="2" Margin="0,8,0,0" Height="48" VerticalAlignment="Top" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <RadioButton x:Name="BtnTrackB" Style="{DynamicResource SegButton}" GroupName="PreviewTrack" Content="Lồng tiếng" IsChecked="True" Padding="12,0" FontSize="14" Margin="0,0,6,0"
                         ToolTip="Phát video hoàn chỉnh với âm thanh đã thu từ Android"/>
            <RadioButton x:Name="BtnTrackA" Style="{DynamicResource SegButton}" GroupName="PreviewTrack" Content="Âm thanh tách" Padding="12,0" FontSize="14" Margin="0"
                         ToolTip="Nghe riêng âm thanh lồng tiếng đã tách và chuẩn hóa (trong .cache)"/>
          </StackPanel>
          <Button x:Name="BtnCopyReup" Grid.Column="1" Style="{DynamicResource BtnPrimary}" FontSize="14" Padding="4,0" Margin="6,0,0,0" ToolTip="Sao chép file vào clipboard để dán (Ctrl+V) khi đăng (Ctrl+C)" AutomationProperties.Name="Sao chép để đăng">
            <StackPanel Orientation="Horizontal"><TextBlock x:Name="TxtCopyIcon" Text="&#xE8C8;" Style="{DynamicResource Icon}" FontSize="15" Margin="0,0,8,0"/><TextBlock x:Name="TxtCopyLabel" Text="Sao chép để đăng" TextTrimming="CharacterEllipsis"/></StackPanel>
          </Button>
          <Button x:Name="BtnMore" Grid.Column="2" Style="{DynamicResource BtnIcon}" Width="44" Height="44" Margin="6,0,0,0" Content="&#xE712;" ToolTip="Thêm: ghi âm lại, mở thư mục, xóa" AutomationProperties.Name="Thêm hành động">
            <Button.ContextMenu>
              <ContextMenu x:Name="MenuMore" Placement="Top">
                <MenuItem x:Name="BtnRedo" Header="Ghi âm lại" Tag="&#xE720;" InputGestureText="Ctrl+R" ToolTip="Ghi âm lại video này (Ctrl+R)" AutomationProperties.Name="Ghi âm lại"/>
                <MenuItem x:Name="BtnFolder" Header="Mở thư mục" Tag="&#xE838;" ToolTip="Mở thư mục xuất" AutomationProperties.Name="Mở thư mục xuất"/>
                <MenuItem x:Name="BtnOpenExt" Header="Mở bằng trình phát ngoài" Tag="&#xE8A7;" ToolTip="Mở bằng trình phát mặc định của Windows" AutomationProperties.Name="Mở bằng trình phát ngoài"/>
                <Separator/>
                <MenuItem x:Name="BtnDeleteCurrent" Header="Xóa video" Tag="&#xE74D;" InputGestureText="Shift+Del" ToolTip="Xóa video đang xem (Shift+Delete)" AutomationProperties.Name="Xóa video đang xem"/>
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
        </Grid>
      </Grid>

    </Grid>

    <!-- ===================================================== dai hanh dong day (72 px): the trang bo tron noi -->
    <Border x:Name="ActionBar" Grid.Row="2" Style="{DynamicResource Card}" Margin="16,0,16,8" Padding="12,6" CornerRadius="26">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="BtnStart" Style="{DynamicResource BtnPrimary}" MinWidth="176" Height="48" FontSize="18" Padding="20,0"
                ToolTip="Bắt đầu xử lý danh sách link (Ctrl+Enter)" AutomationProperties.Name="Bắt đầu hoặc dừng">
          <StackPanel Orientation="Horizontal">
            <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource WhiteGlow}" BorderBrush="{DynamicResource Ink}" BorderThickness="2" Margin="0,0,10,0">
              <TextBlock x:Name="TxtStartGlyph" Text="&#xE768;" Style="{DynamicResource Icon}" FontSize="12" Foreground="{DynamicResource TextOnAccent}"/>
            </Border>
            <AccessText x:Name="TxtStartLabel" Text="_Bắt đầu" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Grid Grid.Column="1" Margin="16,0,14,0" VerticalAlignment="Center">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <DockPanel LastChildFill="True">
            <Border DockPanel.Dock="Left" Background="{DynamicResource ButterSoft}" BorderBrush="{DynamicResource Ink}" BorderThickness="2" CornerRadius="16" Height="32" Padding="12,0" Margin="0,0,10,0" VerticalAlignment="Center">
              <TextBlock x:Name="TxtProgress" Text="0/0" FontWeight="ExtraBold" FontSize="14" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="TxtStat" DockPanel.Dock="Right" Text="" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="12,0,0,0"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <TextBlock x:Name="TxtCurrentItem" Text="Sẵn sàng" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
          </DockPanel>
          <ProgressBar x:Name="Bar" Grid.Row="1" Margin="0,4,10,0" Minimum="0" Maximum="1" Value="0"/>
        </Grid>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Border x:Name="PillSaved" Style="{DynamicResource CountPill}" Background="{DynamicResource MintSoft}" BorderBrush="{DynamicResource MintLine}" ToolTip="Đã lưu">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="10" Height="10" Fill="{DynamicResource Mint}" Stroke="{DynamicResource Ink}" StrokeThickness="1.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
              <TextBlock x:Name="TxtCountSaved" Text="0 đã lưu" FontSize="14" FontWeight="Bold"/>
            </StackPanel>
          </Border>
          <Border x:Name="PillRejected" Style="{DynamicResource CountPill}" Background="{DynamicResource ButterSoft}" BorderBrush="{DynamicResource ButterLine}" ToolTip="Bị loại (không có bản lồng tiếng Việt)">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="10" Height="10" Fill="{DynamicResource Butter}" Stroke="{DynamicResource Ink}" StrokeThickness="1.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
              <TextBlock x:Name="TxtCountRejected" Text="0 bị loại" FontSize="14" FontWeight="Bold"/>
            </StackPanel>
          </Border>
          <Border x:Name="PillUnverified" Style="{DynamicResource CountPill}" Background="{DynamicResource SkySoft}" BorderBrush="{DynamicResource SkyLine}" ToolTip="Chưa xác nhận (chưa kiểm chứng được bản lồng tiếng; thử lại sau)">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="10" Height="10" Fill="{DynamicResource Sky}" Stroke="{DynamicResource Ink}" StrokeThickness="1.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
              <TextBlock x:Name="TxtCountUnverified" Text="0 chưa xác nhận" FontSize="14" FontWeight="Bold"/>
            </StackPanel>
          </Border>
          <Border x:Name="PillSkipped" Style="{DynamicResource CountPill}" Background="{DynamicResource LavenderSoft}" BorderBrush="{DynamicResource LavenderLine}" ToolTip="Bỏ qua (đã loại trước hoặc đã có trong kho)">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="10" Height="10" Fill="{DynamicResource Lavender}" Stroke="{DynamicResource Ink}" StrokeThickness="1.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
              <TextBlock x:Name="TxtCountSkipped" Text="0 bỏ qua" FontSize="14" FontWeight="Bold"/>
            </StackPanel>
          </Border>
          <Border x:Name="PillFailed" Style="{DynamicResource CountPill}" Background="{DynamicResource CoralSoft}" BorderBrush="{DynamicResource CoralLine}" Margin="0" ToolTip="Lỗi">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="10" Height="10" Fill="{DynamicResource Coral}" Stroke="{DynamicResource Ink}" StrokeThickness="1.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
              <TextBlock x:Name="TxtCountFailed" Text="0 lỗi" FontSize="14" FontWeight="Bold"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===================================================== thong bao: goc DUOI phai, ngay tren dai day (code dich sang trai cot xem truoc khi co) -->
    <StackPanel x:Name="NotificationHost" Grid.Row="1" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,24,88" Width="360" Panel.ZIndex="100"/>

  </Grid>
</Window>
