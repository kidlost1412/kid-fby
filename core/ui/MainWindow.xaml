                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Kích thước" Style="{DynamicResource TextLabel}" FontSize="15" VerticalAlignment="Center"/>
                    <Slider x:Name="SldLogoSize" Grid.Column="1" Minimum="5" Maximum="60" Value="30" TickFrequency="1" IsSnapToTickEnabled="True"
                            SmallChange="1" LargeChange="5" AutomationProperties.Name="Kích thước logo"/>
                    <Border Grid.Column="2" Style="{DynamicResource Badge}" Background="{DynamicResource PinkSoft}" BorderBrush="{DynamicResource PinkLine}" HorizontalAlignment="Right">
                      <TextBlock x:Name="TxtLogoSize" Text="30%" FontWeight="ExtraBold" FontSize="14" ToolTip="Phần trăm chiều rộng video; ảnh giữ nguyên tỷ lệ."/>
                    </Border>
                    <TextBlock Grid.Row="1" Text="Độ mờ" Style="{DynamicResource TextLabel}" FontSize="15" VerticalAlignment="Center" Margin="0,12,0,0"/>
                    <Slider x:Name="SldLogoFade" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="95" Value="60" TickFrequency="1" IsSnapToTickEnabled="True"
                            SmallChange="1" LargeChange="5" Margin="0,12,0,0" AutomationProperties.Name="Độ mờ logo"/>
                    <Border Grid.Row="1" Grid.Column="2" Style="{DynamicResource Badge}" Background="{DynamicResource PinkSoft}" BorderBrush="{DynamicResource PinkLine}" HorizontalAlignment="Right" Margin="0,12,0,0">
                      <TextBlock x:Name="TxtLogoFade" Text="60%" FontWeight="ExtraBold" FontSize="14"/>
                    </Border>
                    <TextBlock Grid.Row="2" Text="Chuyển động" Style="{DynamicResource TextLabel}" FontSize="15" VerticalAlignment="Center" Margin="0,14,0,0"/>
                    <ComboBox x:Name="CmbLogoMode" Grid.Row="2" Grid.Column="1" SelectedIndex="0" Margin="0,14,0,0" HorizontalAlignment="Left" Width="260"
                              AutomationProperties.Name="Chuyển động logo">
                      <ComboBoxItem Content="Tự do · di chuyển"/>
                      <ComboBoxItem Content="Cố định · đứng yên"/>
                    </ComboBox>
                    <TextBlock x:Name="TxtLogoMotionHint" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0" Style="{DynamicResource TextCaption}" TextWrapping="Wrap"
                               Text="Tự do: logo dạo quanh khung. Chọn Cố định để đặt vị trí (góc, giữa hoặc kéo thả tùy chỉnh)."/>
                    <StackPanel x:Name="PanelLogoPosition" Grid.Row="3" Grid.ColumnSpan="3" Orientation="Horizontal" Visibility="Collapsed" Margin="0,12,0,0">
                      <TextBlock Text="Vị trí" Style="{DynamicResource TextLabel}" FontSize="15" VerticalAlignment="Center" Width="120"/>
                      <ComboBox x:Name="CmbLogoPosition" SelectedIndex="3" Width="260" IsEnabled="False" AutomationProperties.Name="Vị trí logo">
                        <ComboBoxItem Content="Trên trái"/><ComboBoxItem Content="Trên phải"/>
                        <ComboBoxItem Content="Dưới trái"/><ComboBoxItem Content="Dưới phải"/><ComboBoxItem Content="Giữa"/>
                        <ComboBoxItem Content="Tùy chỉnh (kéo thả)" ToolTip="Vị trí và kích thước do bạn kéo thả trên khung xem trước."/>
                      </ComboBox>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </ContentControl>

              <!-- GIF -->
              <ContentControl Style="{DynamicResource StickerCard}" Margin="0,0,0,14" Padding="20,16">
                <StackPanel>
                  <DockPanel Margin="0,0,0,12">
                    <Border Style="{DynamicResource IconChip}" Background="{DynamicResource Mint}" Width="40" Height="40" CornerRadius="20" Margin="0,0,12,0">
                      <TextBlock Text="&#xE786;" Style="{DynamicResource Icon}" FontSize="16"/>
                    </Border>
                    <CheckBox x:Name="ChkGif" Content="Chèn GIF" IsChecked="False" FontWeight="ExtraBold" FontSize="20" VerticalAlignment="Center"/>
                  </DockPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TxtGifName" Grid.ColumnSpan="3" Text="Chưa chọn file GIF" Style="{DynamicResource TextLabel}" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
                    <Grid Grid.Row="1" Width="68" Height="68" Margin="0,0,12,0" VerticalAlignment="Center">
                      <Border Margin="4,4,0,0" CornerRadius="16" Background="{DynamicResource StickerShadow}"/>
                      <Border Margin="0,0,4,4" CornerRadius="16" Background="{DynamicResource MintSoft}" BorderBrush="{DynamicResource Ink}" BorderThickness="2" Padding="6">
                        <Image x:Name="ImgGifPreview" Stretch="Uniform"/>
                      </Border>
                    </Grid>
                    <Grid Grid.Row="1" Grid.Column="1" Height="68" Margin="0,0,12,0" VerticalAlignment="Center">
                      <TextBox x:Name="TxtGifPath" IsReadOnly="True" FontSize="13" Height="64" MinHeight="64" VerticalAlignment="Top" ToolTip="Đường dẫn file GIF (.gif) đã chọn." AutomationProperties.Name="Đường dẫn GIF"/>
                    </Grid>
                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button x:Name="BtnPickGif" Content="Chọn GIF…" Style="{DynamicResource BtnMint}"/>
                    </StackPanel>
                  </Grid>
                  <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="120"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto" MinWidth="100"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Kích thước" Style="{DynamicResource TextLabel}" FontSize="15" VerticalAlignment="Center"/>
                    <Slider x:Name="SldGifSize" Grid.Column="1" Minimum="5" Maximum="100" Value="20" TickFrequency="1" IsSnapToTickEnabled="True"
                            SmallChange="1" LargeChange="5" AutomationProperties.Name="Kích thước GIF"/>
                    <Border Grid.Column="2" Style="{DynamicResource Badge}" Background="{DynamicResource MintSoft}" BorderBrush="{DynamicResource MintLine}" HorizontalAlignment="Right">
                      <TextBlock x:Name="TxtGifSize" Text="20%" FontWeight="ExtraBold" FontSize="14" ToolTip="Phần trăm chiều rộng video."/>
                    </Border>
                    <TextBlock Grid.Row="1" Text="Vị trí" Style="{DynamicResource TextLabel}" FontSize="15" VerticalAlignment="Center" Margin="0,14,0,0"/>
                    <WrapPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,14,0,0">
                      <ComboBox x:Name="CmbGifPosition" SelectedIndex="1" Width="260" Margin="0,0,10,0" AutomationProperties.Name="Vị trí GIF">
                        <ComboBoxItem Content="Trên trái"/><ComboBoxItem Content="Trên phải"/>
                        <ComboBoxItem Content="Dưới trái"/><ComboBoxItem Content="Dưới phải"/><ComboBoxItem Content="Giữa"/>
                        <ComboBoxItem Content="Tùy chỉnh (kéo thả)" ToolTip="Vị trí và kích thước do bạn kéo thả trên khung xem trước."/>
                      </ComboBox>
                      <Button x:Name="BtnGifFullFrame" Content="Phủ đầy khung" ToolTip="Kéo giãn GIF phủ kín khung xem trước và video."/>
                    </WrapPanel>
                  </Grid>
                </StackPanel>
              </ContentControl>

              <!-- Lop dang chinh + ap dung -->
              <ContentControl Style="{DynamicResource StickerCard}" Background="{DynamicResource ButterSoft}" Padding="20,16">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Chỉnh trên khung xem trước" Style="{DynamicResource TextHeading}"/>
                    <Image Source="{DynamicResource DecoStar}" Width="20" Height="20" Margin="8,0,0,6" VerticalAlignment="Center"/>
                  </StackPanel>
                  <TextBlock Text="Kéo để di chuyển; kéo cạnh hoặc góc để đổi kích thước; lăn chuột trên lớp để phóng to/thu nhỏ."
                             Style="{DynamicResource TextMutedStyle}" Margin="0,4,0,12"/>
                  <WrapPanel>
                    <TextBlock Text="Lớp đang chỉnh" Style="{DynamicResource TextLabel}" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,10"/>
                    <Button x:Name="BtnSelectLogo" Content="Logo" Margin="0,0,8,10" IsEnabled="False" ToolTip="Đưa logo lên trước để kéo hoặc chỉnh kích thước."/>
                    <Button x:Name="BtnSelectGif" Content="GIF" Margin="0,0,16,10" IsEnabled="False" ToolTip="Đưa GIF lên trước để kéo hoặc chỉnh kích thước."/>
                    <Button x:Name="BtnReedit" Style="{DynamicResource BtnPrimary}" Margin="0,0,0,10" IsEnabled="False" AutomationProperties.Name="Áp dụng logo và GIF lên video đang xem"
                            ToolTip="Dùng lại video gốc sạch và âm thanh đã lưu (trong .cache) để áp dụng logo/GIF mới, không tải hoặc ghi âm lại.">
                      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE70F;" Style="{DynamicResource Icon}" FontSize="15" Margin="0,0,8,0"/><TextBlock Text="Áp dụng lên video đang xem" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                  </WrapPanel>
                </StackPanel>
              </ContentControl>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <!-- ================================================= HANG DOI -->
        <Grid x:Name="ViewQueue" Visibility="Collapsed" Margin="24,4,24,10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <DockPanel Height="48" Margin="0,0,0,12">
            <Border Style="{DynamicResource IconChip}" Background="{DynamicResource Butter}" Width="40" Height="40" CornerRadius="20" Margin="0,0,12,0">
              <TextBlock Text="&#xE8FD;" Style="{DynamicResource Icon}" FontSize="18"/>
            </Border>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Grid VerticalAlignment="Center"><Image Source="{DynamicResource DecoRibbon}" Stretch="Fill" Height="16" VerticalAlignment="Bottom" Margin="-8,0,-12,2" IsHitTestVisible="False"/><TextBlock Text="Hàng đợi" Style="{DynamicResource TextTitle}"/></Grid><Image Source="{DynamicResource DecoSparkles}" Width="30" Height="24" Margin="8,0,0,8" VerticalAlignment="Center"/></StackPanel>
            <TextBlock x:Name="TxtQueueHeader" Text="Mỗi link là một thẻ; bấm vào thẻ để xem chi tiết 7 bước." Style="{DynamicResource TextMutedStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="16,0,0,0"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
          </DockPanel>
          <Grid Grid.Row="1">
            <ListView x:Name="QueueList" SelectionMode="Single" AutomationProperties.Name="Bảng hàng đợi" Margin="-5,-5,-5,0">
              <ListView.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Border Margin="4,4,0,0" CornerRadius="20" Background="{DynamicResource StickerShadow}"/>
                    <Border Margin="0,0,4,4" CornerRadius="20" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource Ink}" BorderThickness="2" Padding="14,12">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="200"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="21" Background="{DynamicResource ButterSoft}" BorderBrush="{DynamicResource Ink}" BorderThickness="2"
                                Margin="0,0,14,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Index}" FontWeight="ExtraBold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                          <TextBlock Text="{Binding IdText}" ToolTip="{Binding Url}" FontWeight="ExtraBold" FontSize="16" TextTrimming="CharacterEllipsis"/>
                          <Border x:Name="StatusBadge" Style="{DynamicResource StatusBadge}" Margin="0,6,0,0">
                            <TextBlock Text="{Binding StatusText}" Style="{DynamicResource StatusBadgeText}"/>
                          </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                          <StackPanel Orientation="Horizontal">
                            <Grid Width="196" ToolTip="7 bước: công cụ · thiết bị · ID · chọn tiếng Việt · thu âm · chuẩn hóa · ghép MP4">
                              <Border Height="4" CornerRadius="2" Background="{DynamicResource InkFaint}" Margin="14,0" VerticalAlignment="Center"/>
                              <ItemsControl ItemsSource="{Binding Beads}" Focusable="False" IsTabStop="False">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Border Style="{DynamicResource BeadDot}" HorizontalAlignment="Center">
                                      <TextBlock Style="{DynamicResource BeadGlyph}"/>
                                    </Border>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </Grid>
                            <TextBlock Text="{Binding StepText}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                          </StackPanel>
                          <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Message}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Tag="detail" Content="Chi tiết" Style="{DynamicResource BtnLinkSmall}" Margin="8,-8,0,-8" AutomationProperties.Name="Chi tiết lỗi">
                              <Button.Visibility>
                                <Binding Path="HasDetail">
                                  <Binding.Converter>
                                    <BooleanToVisibilityConverter/>
                                  </Binding.Converter>
                                </Binding>
                              </Button.Visibility>
                            </Button>
                          </Grid>
                          <TextBlock Text="{Binding SyncText}" FontSize="13" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding SyncText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                  <DataTrigger Binding="{Binding SyncWarn}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarningText}"/></DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="3" Content="{Binding ActionText}" Tag="{Binding ActionKind}" Style="{DynamicResource RowActionButton}" VerticalAlignment="Center"
                                ToolTip="{Binding ActionText}" AutomationProperties.Name="{Binding ActionText}"/>
                      </Grid>
                    </Border>
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
            <Viewbox x:Name="QueueEmpty" StretchDirection="DownOnly" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
              <StackPanel>
                <Image Source="{DynamicResource MascotCloud}" Width="132" Height="104"/>
                <TextBlock Text="Chưa có hàng đợi" Style="{DynamicResource TextHeading}" FontSize="24" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                <TextBlock Text="Dán link ở trang Nguồn rồi bấm Bắt đầu nhé!" Style="{DynamicResource TextMutedStyle}" FontSize="15" HorizontalAlignment="Center"/>
              </StackPanel>
            </Viewbox>
          </Grid>
          <!-- chi tiet 7 buoc -->
          <ContentControl Grid.Row="2" Style="{DynamicResource StickerCard}" Margin="0,12,0,0" Padding="18,12">
            <StackPanel>
              <TextBlock x:Name="TxtStepTitle" Text="Chi tiết các bước" Style="{DynamicResource TextHeading}" FontSize="18" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>
              <ItemsControl x:Name="StepList" Focusable="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel ToolTip="{Binding Detail}">
                      <Grid Height="44">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border x:Name="LineL" Height="4" CornerRadius="2" Background="{DynamicResource InkFaint}" VerticalAlignment="Center"/>
                        <Border x:Name="LineR" Grid.Column="1" Height="4" CornerRadius="2" Background="{DynamicResource InkFaint}" VerticalAlignment="Center"/>
                        <Border Grid.ColumnSpan="2" Style="{DynamicResource StepDot}" HorizontalAlignment="Center" VerticalAlignment="Center">
                          <Grid>
                            <TextBlock x:Name="StepNo" Text="{Binding No}" FontWeight="ExtraBold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StepIcon" Text="{Binding Glyph}" Style="{DynamicResource StepGlyph}" Visibility="Collapsed"/>
                          </Grid>
                        </Border>
                      </Grid>
                      <TextBlock Text="{Binding Name}" Style="{DynamicResource StepName}" TextWrapping="Wrap" Margin="2,4,2,0"/>
                    </StackPanel>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding Edge}" Value="first"><Setter TargetName="LineL" Property="Visibility" Value="Hidden"/></DataTrigger>
                      <DataTrigger Binding="{Binding Edge}" Value="last"><Setter TargetName="LineR" Property="Visibility" Value="Hidden"/></DataTrigger>
                      <DataTrigger Binding="{Binding State}" Value="done">
                        <Setter TargetName="StepNo" Property="Visibility" Value="Collapsed"/><Setter TargetName="StepIcon" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="LineL" Property="Background" Value="{DynamicResource MintLine}"/><Setter TargetName="LineR" Property="Background" Value="{DynamicResource MintLine}"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding State}" Value="failed">
                        <Setter TargetName="StepNo" Property="Visibility" Value="Collapsed"/><Setter TargetName="StepIcon" Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ContentControl>
        </Grid>

        <!-- ================================================= KHO -->
        <Grid x:Name="ViewLibrary" Visibility="Collapsed" Margin="24,4,24,10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <DockPanel Height="48" Margin="0,0,0,10" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
              <RadioButton x:Name="TabLibVideos" Style="{DynamicResource SegButton}" GroupName="LibTabs" Content="Video đã lưu" IsChecked="True" AutomationProperties.Name="Video đã lưu"/>
              <RadioButton x:Name="TabLibRejected" Style="{DynamicResource SegButton}" GroupName="LibTabs" Margin="0" AutomationProperties.Name="Lịch sử đã loại">
                <TextBlock x:Name="TxtRejectedTabLabel" Text="Lịch sử đã loại (0)"/>
