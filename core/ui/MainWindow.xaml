<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Kid FB.Y"
        Width="1440" Height="900" MinWidth="1200" MinHeight="720"
        WindowStartupLocation="Manual"
        Background="{DynamicResource Surface0}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="{DynamicResource FontUi}" FontSize="15"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <!--
    Kid FB.Y - cay cua so chinh, phong cach "cute" (dot 4). Nap boi core\kid-fby-gui.ps1.
    Moi mau/style lay tu Theme.xaml qua DynamicResource (theme duoc merge sau khi parse).
    Ten x:Name duoc code dung qua $ui[...] - doi ten phai sua dong bo danh sach trong GUI va SelfTest.
  -->
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
  </shell:WindowChrome.WindowChrome>

  <Grid x:Name="RootGrid" Background="{DynamicResource Surface0}">
    <Grid.RowDefinitions>
      <RowDefinition Height="48"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <!-- giay cham tron rat nhat phia sau moi thu -->
    <Rectangle Grid.RowSpan="3" Fill="{DynamicResource PaperDots}" IsHitTestVisible="False"/>

    <!-- ===================================================== thanh tieu de -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
        <Grid Width="38" Height="38" Margin="0,0,10,0">
          <Ellipse Margin="3,3,0,0" Fill="{DynamicResource StickerShadow}"/>
          <Ellipse Margin="0,0,3,3" Fill="{DynamicResource Pink}" Stroke="{DynamicResource Ink}" StrokeThickness="2"/>
          <Image Source="{DynamicResource MascotCloud}" Width="26" Height="20" Margin="0,2,3,3"/>
        </Grid>
        <TextBlock Text="Kid FB.Y" FontWeight="ExtraBold" FontSize="22" VerticalAlignment="Center"/>
        <Border Style="{DynamicResource Badge}" Background="{DynamicResource LavenderSoft}" BorderBrush="{DynamicResource LavenderLine}" Margin="10,2,0,0" Padding="10,1">
          <TextBlock x:Name="TxtAppVersion" Text="v1.0.0" FontSize="13" FontWeight="Bold"/>
        </Border>
        <Image Source="{DynamicResource DecoHeart}" Width="18" Height="18" Margin="10,0,0,10" VerticalAlignment="Center"/>
      </StackPanel>

      <StackPanel x:Name="HeaderBadges" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Button x:Name="ChipDevice" Style="{DynamicResource ChipButton}" ToolTip="Chưa kiểm tra thiết bị Android. Bấm để kiểm tra."
                AutomationProperties.Name="Trạng thái thiết bị">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="ChipDeviceDot" Width="10" Height="10" Fill="{DynamicResource Neutral}" Stroke="{DynamicResource Ink}" StrokeThickness="1.5" VerticalAlignment="Center" Margin="0,0,7,0"/>
            <TextBlock Text="&#xE8EA;" Style="{DynamicResource Icon}" FontSize="14" Margin="0,0,7,0"/>
            <TextBlock x:Name="ChipDeviceText" Text="Thiết bị" FontSize="14" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="ChipTools" Style="{DynamicResource ChipButton}" ToolTip="Chưa kiểm tra công cụ. Bấm để mở Cài đặt › Công cụ."
                AutomationProperties.Name="Trạng thái công cụ">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="ChipToolsDot" Width="10" Height="10" Fill="{DynamicResource Neutral}" Stroke="{DynamicResource Ink}" StrokeThickness="1.5" VerticalAlignment="Center" Margin="0,0,7,0"/>
            <TextBlock Text="&#xE90F;" Style="{DynamicResource Icon}" FontSize="14" Margin="0,0,7,0"/>
            <TextBlock x:Name="ChipToolsText" Text="Công cụ" FontSize="14" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </StackPanel>

      <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Button x:Name="BtnWinMin" Style="{DynamicResource WinBtn}" Background="{DynamicResource MintSoft}" Content="&#xE921;" ToolTip="Thu nhỏ" AutomationProperties.Name="Thu nhỏ"/>
        <Button x:Name="BtnWinMax" Style="{DynamicResource WinBtn}" Background="{DynamicResource ButterSoft}" Content="&#xE922;" ToolTip="Phóng to" AutomationProperties.Name="Phóng to"/>
        <Button x:Name="BtnWinClose" Style="{DynamicResource WinBtnClose}" Background="{DynamicResource PinkSoft}" Content="&#xE8BB;" ToolTip="Đóng" AutomationProperties.Name="Đóng"/>
      </StackPanel>
    </Grid>

    <!-- ===================================================== than: sidebar | trang | xem truoc -->
    <Grid Grid.Row="1" x:Name="BodyGrid">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="ColSidebar" Width="96"/>
        <ColumnDefinition x:Name="ColPage" Width="*"/>
        <ColumnDefinition x:Name="ColPreview" Width="0"/>
      </Grid.ColumnDefinitions>

      <!-- Sidebar: sticker tron moi trang mot mau -->
      <Border x:Name="SidebarBorder" Grid.Column="0" Margin="0,4,0,10" Background="{DynamicResource SurfaceAlt}" CornerRadius="0,30,30,0" BorderBrush="{DynamicResource InkFaint}" BorderThickness="0,2,2,2">
      <ScrollViewer x:Name="SidebarScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False" IsTabStop="False">
      <Grid Margin="2,4,2,8" MinHeight="{Binding ViewportHeight, ElementName=SidebarScroll}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel HorizontalAlignment="Center">
          <RadioButton x:Name="NavSource" Style="{DynamicResource NavButton}" BorderBrush="{DynamicResource Pink}" Tag="&#xE71B;" Content="Nguồn" IsChecked="True"
                       ToolTip="Nguồn: link và thư mục xuất (Ctrl+1)" AutomationProperties.Name="Nguồn"/>
          <RadioButton x:Name="NavBrand" Style="{DynamicResource NavButton}" BorderBrush="{DynamicResource Lavender}" Tag="&#xE790;" Content="Thương hiệu"
                       ToolTip="Thương hiệu: logo và GIF (Ctrl+2)" AutomationProperties.Name="Thương hiệu"/>
          <RadioButton x:Name="NavQueue" Style="{DynamicResource NavButton}" BorderBrush="{DynamicResource Butter}" Tag="&#xE8FD;" Content="Hàng đợi"
                       ToolTip="Hàng đợi (Ctrl+3)" AutomationProperties.Name="Hàng đợi"/>
          <RadioButton x:Name="NavLibrary" Style="{DynamicResource NavButton}" BorderBrush="{DynamicResource Mint}" Tag="&#xE8F1;" Content="Kho"
                       ToolTip="Kho video đã lưu (Ctrl+4)" AutomationProperties.Name="Kho"/>
        </StackPanel>
        <Image x:Name="SidebarDeco" Grid.Row="1" Source="{DynamicResource DecoSparkles}" Width="30" Height="24" VerticalAlignment="Bottom" Margin="0,0,0,6" Opacity="0.9" IsHitTestVisible="False"/>
        <RadioButton x:Name="NavSettings" Grid.Row="2" Style="{DynamicResource NavButton}" BorderBrush="{DynamicResource Sky}" Tag="&#xE713;" Content="Cài đặt"
                     HorizontalAlignment="Center" ToolTip="Cài đặt (Ctrl+5)" AutomationProperties.Name="Cài đặt"/>
      </Grid>
      </ScrollViewer>
      </Border>

      <!-- Cac trang (chong cung mot o) -->
      <Grid x:Name="PageHost" Grid.Column="1">

        <!-- ================================================= NGUON -->
        <ScrollViewer x:Name="ViewSource" Margin="24,4,12,10" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" IsTabStop="False">
        <Grid Margin="0,0,12,0" MinHeight="{Binding ViewportHeight, ElementName=ViewSource}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <DockPanel Height="48" Margin="0,0,0,12">
            <Border Style="{DynamicResource IconChip}" Background="{DynamicResource Pink}" Width="40" Height="40" CornerRadius="20" Margin="0,0,12,0">
              <TextBlock Text="&#xE71B;" Style="{DynamicResource Icon}" FontSize="18"/>
            </Border>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Grid VerticalAlignment="Center"><Image Source="{DynamicResource DecoRibbon}" Stretch="Fill" Height="16" VerticalAlignment="Bottom" Margin="-8,0,-12,2" IsHitTestVisible="False"/><TextBlock Text="Nguồn" Style="{DynamicResource TextTitle}"/></Grid><Image Source="{DynamicResource DecoSparkles}" Width="30" Height="24" Margin="8,0,0,8" VerticalAlignment="Center"/></StackPanel>
            <TextBlock x:Name="TxtSourceSubtitle" Text="Dán link Reel hoặc video Facebook, mỗi dòng một link. Xong thì bấm Bắt đầu (Ctrl+Enter)."
                       Style="{DynamicResource TextMutedStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="16,0,0,0"
                       ToolTip="Dán link Reel hoặc video Facebook, mỗi dòng một link. Xong thì bấm Bắt đầu (Ctrl+Enter) ở dải dưới."/>
          </DockPanel>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="18"/>
              <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- O link: to giay note -->
            <ContentControl Style="{DynamicResource StickerCard}" Padding="18">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*" MinHeight="200"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="1">
                  <TextBox x:Name="TxtLinks" Style="{DynamicResource NotePaper}" AcceptsReturn="True" AcceptsTab="False" TextWrapping="NoWrap"
                           VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MinHeight="180" Padding="18,8,14,8"
                           AutomationProperties.Name="Danh sách link Facebook"/>
                  <StackPanel IsHitTestVisible="False" Margin="22,10,90,12">
                    <TextBlock x:Name="TxtLinksPlaceholder" FontFamily="{DynamicResource FontMono}" FontSize="14" LineHeight="28" LineStackingStrategy="BlockLineHeight"
                               Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Opacity="0.6" FontStyle="Italic"
                               Text="Ví dụ (dán link thật vào đây):&#x0a;https://www.facebook.com/reel/1234567890&#x0a;https://www.facebook.com/share/r/AbCdEf/&#x0a;https://fb.watch/xyz/&#x0a;&#x0a;Mỗi dòng một link nhé. Link trùng hoặc đã loại sẽ được đếm ở thẻ Tóm tắt."/>
                  </StackPanel>
                  <!-- may chi hien khi o rong (khong de len chu) -->
                  <Image Width="56" Height="44" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,14" IsHitTestVisible="False" Opacity="0.95">
                    <Image.Style>
                      <Style TargetType="Image">
                        <Setter Property="Source" Value="{DynamicResource MascotCloud}"/>
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Text, ElementName=TxtLinks}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Image.Style>
                  </Image>
                </Grid>
                <StackPanel x:Name="PanelDownloadKho" Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                  <Border Style="{DynamicResource IconChip}" Background="{DynamicResource Mint}" Width="34" Height="34" CornerRadius="17" Margin="0,0,10,0"><TextBlock Text="&#xE8F1;" Style="{DynamicResource Icon}" FontSize="14"/></Border>
                  <TextBlock Text="Lưu vào kho" Style="{DynamicResource TextHeading}" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                  <ComboBox x:Name="CmbDownloadKho" Width="320" AutomationProperties.Name="Lưu vào kho" ToolTip="Video tải xong sẽ vào kho này (có thể chuyển kho sau trong trang Kho)"/>
                </StackPanel>
                <WrapPanel Grid.Row="0" Margin="0,0,0,12" Orientation="Horizontal">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Border Style="{DynamicResource IconChip}" Background="{DynamicResource Butter}" Width="40" Height="40" CornerRadius="20" Margin="0,0,10,0">
                      <TextBlock Text="&#xE70B;" Style="{DynamicResource Icon}" FontSize="16"/>
                    </Border>
                    <TextBlock Text="Danh sách link" Style="{DynamicResource TextHeading}" VerticalAlignment="Center"/>
                  </StackPanel>
                  <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnPasteLinks" Style="{DynamicResource BtnButter}" Margin="0,0,10,0" ToolTip="Dán link từ clipboard" AutomationProperties.Name="Dán link">
                      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE77F;" Style="{DynamicResource Icon}" FontSize="15" Margin="0,0,8,0"/><AccessText Text="_Dán" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button x:Name="BtnImportLinks" Margin="0,0,10,0" ToolTip="Nhập link từ file .txt" AutomationProperties.Name="Nhập file txt">
                      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8E5;" Style="{DynamicResource Icon}" FontSize="15" Margin="0,0,8,0"/><TextBlock Text="Nhập .txt" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button x:Name="BtnClearLinks" Style="{DynamicResource BtnGhost}" ToolTip="Xóa toàn bộ link (Ctrl+Z để hoàn tác)" AutomationProperties.Name="Xóa danh sách link">
                      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{DynamicResource Icon}" FontSize="15" Margin="0,0,8,0"/><TextBlock Text="Xóa" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                  </WrapPanel>
                </WrapPanel>
                <!-- chinh sach ngon ngu: dai 1 dong + nut "?" (an khi man hinh thap) -->
                <Border x:Name="PolicyStrip" Grid.Row="3" Margin="0,10,0,0" Background="{DynamicResource SkySoft}" BorderBrush="{DynamicResource SkyLine}" BorderThickness="2" CornerRadius="16" Padding="12,0,2,0">
                  <DockPanel>
                    <Button x:Name="BtnPolicyHelp" DockPanel.Dock="Right" Style="{DynamicResource BtnIconSmall}" Content="&#xE897;" ToolTip="Xem đầy đủ chính sách ngôn ngữ" AutomationProperties.Name="Xem chính sách ngôn ngữ"/>
                    <Popup x:Name="PopPolicy" PlacementTarget="{Binding ElementName=BtnPolicyHelp}" Placement="Top" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                      <Grid Margin="6,6,10,10" MaxWidth="440">
                        <Border Margin="4,4,0,0" CornerRadius="16" Background="{DynamicResource StickerShadow}"/>
                        <Border Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource Ink}" BorderThickness="2" CornerRadius="16" Padding="14,10" Margin="0,0,4,4">
                          <TextBlock Style="{DynamicResource TextBody}" FontSize="14" LineHeight="21" Text="{Binding Text, ElementName=TxtLanguagePolicy}"/>
                        </Border>
                      </Grid>
                    </Popup>
                    <TextBlock x:Name="TxtLanguagePolicy" Style="{DynamicResource TextMutedStyle}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                               Text="Ứng dụng chọn tiếng Việt trên Meta và tự bỏ qua video không có bản lồng tiếng. Việc xác nhận dựa vào giao diện Facebook, không phân tích ngôn ngữ trong âm thanh."/>

                  </DockPanel>
                </Border>
                <!-- washi o vien ngoai the (khong che chu) -->
                <Border x:Name="WashiLeft" Grid.RowSpan="3" Width="64" Height="20" CornerRadius="3" Background="#B3FED7E2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-26,-22,0,0" IsHitTestVisible="False">
                  <Border.RenderTransform><RotateTransform Angle="-28"/></Border.RenderTransform>
                </Border>
                <Border x:Name="WashiRight" Grid.RowSpan="3" Width="64" Height="20" CornerRadius="3" Background="#B3C6F6D5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-22,-26,0" IsHitTestVisible="False">
                  <Border.RenderTransform><RotateTransform Angle="28"/></Border.RenderTransform>
                </Border>
              </Grid>
            </ContentControl>

            <!-- Cot phai: thu muc xuat + tom tat -->
            <StackPanel Grid.Column="2">
                <ContentControl Style="{DynamicResource StickerCard}" Margin="0,0,0,12" Padding="16,12">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <Border Style="{DynamicResource IconChip}" Background="{DynamicResource Peach}" Width="34" Height="34" CornerRadius="17" Margin="0,0,10,0">
                        <TextBlock Text="&#xE8B7;" Style="{DynamicResource Icon}" FontSize="14"/>
                      </Border>
                      <TextBlock Text="Thư mục xuất" Style="{DynamicResource TextHeading}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid Margin="0,10,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Grid>
                      <TextBox x:Name="TxtOut" Style="{DynamicResource TextBoxPath}" FontSize="14" AutomationProperties.Name="Thư mục xuất"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}">

                      </TextBox>
                      <TextBlock x:Name="TxtOutShort" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="16,0,14,0" VerticalAlignment="Center" IsHitTestVisible="False" TextWrapping="NoWrap">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=TxtOut}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Grid>
                      <Button Grid.Column="1" x:Name="BtnPick" Style="{DynamicResource BtnIcon}" Background="{DynamicResource Peach}" Content="&#xE8DA;" Margin="6,0,0,0"
                              ToolTip="Chọn thư mục xuất…" AutomationProperties.Name="Chọn thư mục xuất"/>
                      <Button Grid.Column="2" x:Name="BtnOpenOut" Style="{DynamicResource BtnIcon}" Background="{DynamicResource ButterSoft}" Content="&#xE838;" Margin="6,0,0,0"
                              ToolTip="Mở thư mục xuất" AutomationProperties.Name="Mở thư mục xuất"/>
                    </Grid>
                    <TextBlock Text="Chỉ file hoàn chỉnh (-3) hiện ở đây; file gốc để sửa lại logo nằm trong thư mục ẩn .cache." Style="{DynamicResource TextCaption}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                  </StackPanel>
                </ContentControl>
                <ContentControl Style="{DynamicResource StickerCard}" Padding="16,12">
                  <StackPanel>
                    <TextBlock Text="Tóm tắt" Style="{DynamicResource TextHeading}"/>
                    <UniformGrid Columns="2" Rows="2" Margin="0,10,0,0">
                      <Border Background="{DynamicResource SkySoft}" BorderBrush="{DynamicResource Ink}" BorderThickness="2" CornerRadius="16" Padding="12,4" Margin="0,0,5,8">
                        <DockPanel><TextBlock x:Name="TxtSumLinks" Text="0" FontWeight="ExtraBold" FontSize="24" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="Link" Style="{DynamicResource TextSummaryLabel}"/></DockPanel>
                      </Border>
                      <Border Background="{DynamicResource PeachSoft}" BorderBrush="{DynamicResource Ink}" BorderThickness="2" CornerRadius="16" Padding="12,4" Margin="5,0,0,8">
                        <DockPanel><TextBlock x:Name="TxtSumDup" Text="0" FontWeight="ExtraBold" FontSize="24" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="Trùng" Style="{DynamicResource TextSummaryLabel}"/></DockPanel>
                      </Border>
                      <Border Background="{DynamicResource LavenderSoft}" BorderBrush="{DynamicResource Ink}" BorderThickness="2" CornerRadius="16" Padding="12,4" Margin="0,0,5,0">
                        <DockPanel><TextBlock x:Name="TxtSumRejected" Text="0" FontWeight="ExtraBold" FontSize="24" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="Đã loại trước" Style="{DynamicResource TextSummaryLabel}"/></DockPanel>
                      </Border>
                      <Border Background="{DynamicResource MintSoft}" BorderBrush="{DynamicResource Ink}" BorderThickness="2" CornerRadius="16" Padding="12,4" Margin="5,0,0,0">
                        <DockPanel><TextBlock x:Name="TxtSumRun" Text="0" FontWeight="ExtraBold" FontSize="24" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="Sẽ chạy" Style="{DynamicResource TextSummaryLabel}"/></DockPanel>
                      </Border>
                    </UniformGrid>
                    <!-- Cau tom tat day du giu cho trinh doc man hinh/kiem thu; da co 4 sticker so nen an khoi giao dien. -->
                    <TextBlock x:Name="TxtLinkSummary" Text="Chưa có link nào" Style="{DynamicResource TextMutedStyle}" Visibility="Collapsed"/>
                    <TextBlock x:Name="TxtDuplicateWarning" Visibility="Collapsed" Style="{DynamicResource TextMutedStyle}" Margin="0,8,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    <Border x:Name="PanelDupChoice" Style="{DynamicResource CardInset}" Background="{DynamicResource LavenderSoft}" Margin="0,10,0,0" Padding="12,8" Visibility="Collapsed">
                      <StackPanel>
                        <TextBlock Text="Với video đã có trong kho" Style="{DynamicResource TextLabel}" FontSize="15" FontWeight="ExtraBold" Margin="0,0,0,6"/>
                        <RadioButton x:Name="RbDupSkip" GroupName="DupChoice" Content="Bỏ qua, chỉ chạy video mới" IsChecked="True" Margin="0,0,0,6"/>
                        <RadioButton x:Name="RbDupRedownload" GroupName="DupChoice" Content="Tải và ghi âm lại"/>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </ContentControl>
            </StackPanel>
          </Grid>
        </Grid>
        </ScrollViewer>

        <!-- ================================================= THUONG HIEU -->
        <Grid x:Name="ViewBrand" Visibility="Collapsed" Margin="24,4,24,10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <DockPanel Height="48" Margin="0,0,0,12" LastChildFill="True">
            <Border DockPanel.Dock="Right" Style="{DynamicResource Badge}" Background="{DynamicResource LavenderSoft}" BorderBrush="{DynamicResource LavenderLine}" VerticalAlignment="Center" Padding="14,4" Margin="12,0,0,0">
              <TextBlock x:Name="TxtWatermarkSummary" Text="Logo: 30% · GIF: Tắt" FontSize="14" FontWeight="Bold"/>
            </Border>
            <Border Style="{DynamicResource IconChip}" Background="{DynamicResource Lavender}" Width="40" Height="40" CornerRadius="20" Margin="0,0,12,0">
              <TextBlock Text="&#xE790;" Style="{DynamicResource Icon}" FontSize="18"/>
            </Border>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Grid VerticalAlignment="Center"><Image Source="{DynamicResource DecoRibbon}" Stretch="Fill" Height="16" VerticalAlignment="Bottom" Margin="-8,0,-12,2" IsHitTestVisible="False"/><TextBlock Text="Thương hiệu" Style="{DynamicResource TextTitle}"/></Grid><Image Source="{DynamicResource DecoHeart}" Width="22" Height="20" Margin="8,0,0,8" VerticalAlignment="Center"/></StackPanel>
            <TextBlock Text="Logo và GIF được chèn vào mọi video. Kéo thẳng trên khung xem trước để đặt chỗ."
                       Style="{DynamicResource TextMutedStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="16,0,0,0"
                       ToolTip="Logo và GIF được chèn vào mọi video. Kéo thẳng trên khung xem trước bên phải để đặt chỗ."/>
          </DockPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-6,0">
            <StackPanel Margin="0,0,10,0">
              <!-- Logo -->
              <ContentControl Style="{DynamicResource StickerCard}" Margin="0,0,0,14" Padding="20,16">
                <StackPanel>
                  <DockPanel Margin="0,0,0,12">
                    <Border Style="{DynamicResource IconChip}" Background="{DynamicResource Pink}" Width="40" Height="40" CornerRadius="20" Margin="0,0,12,0">
                      <TextBlock Text="&#xE8B9;" Style="{DynamicResource Icon}" FontSize="16"/>
                    </Border>
                    <CheckBox x:Name="ChkWatermark" Content="Chèn logo" IsChecked="True" FontWeight="ExtraBold" FontSize="20" VerticalAlignment="Center"/>
                  </DockPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TxtLogoName" Grid.ColumnSpan="3" Text="Đang dùng: Logo Kid" Style="{DynamicResource TextLabel}" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
                    <Grid Grid.Row="1" Width="68" Height="68" Margin="0,0,12,0" VerticalAlignment="Center">
                      <Border Margin="4,4,0,0" CornerRadius="16" Background="{DynamicResource StickerShadow}"/>
