      <DrawingGroup>
        <GeometryDrawing Brush="#00FFFFFF"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,64,50"/></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Brush="#2E5B3A29" Geometry="M 20,45 C 11.5,45 6.5,39 8.5,31.5 C 10,26 15,23 20.5,24 C 21.5,15.5 28.5,10 36.5,11 C 43.5,12 48.5,17.5 49.5,24 C 56.5,23 62.5,28 61.5,35 C 60.5,41 55.5,45 49.5,45 Z"/>
        <GeometryDrawing Brush="#FFFFFFFF" Geometry="{StaticResource GeoCloud}">
          <GeometryDrawing.Pen><Pen Brush="#FF5B3A29" Thickness="2.6" LineJoin="Round"/></GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Brush="#CCFF9EC7"><GeometryDrawing.Geometry><EllipseGeometry Center="20.5,33" RadiusX="3.6" RadiusY="2.3"/></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Brush="#CCFF9EC7"><GeometryDrawing.Geometry><EllipseGeometry Center="43.5,33" RadiusX="3.6" RadiusY="2.3"/></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Brush="#FF5B3A29"><GeometryDrawing.Geometry><EllipseGeometry Center="25.5,28.5" RadiusX="2.1" RadiusY="2.4"/></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Brush="#FF5B3A29"><GeometryDrawing.Geometry><EllipseGeometry Center="38.5,28.5" RadiusX="2.1" RadiusY="2.4"/></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Brush="#FFFFFFFF"><GeometryDrawing.Geometry><EllipseGeometry Center="26.2,27.7" RadiusX="0.7" RadiusY="0.7"/></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Brush="#FFFFFFFF"><GeometryDrawing.Geometry><EllipseGeometry Center="39.2,27.7" RadiusX="0.7" RadiusY="0.7"/></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Geometry="M 28.5,32.5 Q 32,36.2 35.5,32.5">
          <GeometryDrawing.Pen><Pen Brush="#FF5B3A29" Thickness="2" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

