  <!-- Dieu huong sidebar: sticker tron 56 px (mau = Background) + nhan 14 SemiBold. Chon: vien nau day + nay nhe 1.0 -> 1.06 -->
  <Style x:Key="NavButton" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource NavLabel}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Pink}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Width" Value="{DynamicResource NavBtnW}"/>
    <Setter Property="Height" Value="{DynamicResource NavBtnH}"/>
    <Setter Property="Margin" Value="{DynamicResource NavMargin}"/>
    <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="{DynamicResource NavFont}"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="GroupName" Value="MainNav"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <Grid x:Name="Sticker" Width="{DynamicResource NavDot}" Height="{DynamicResource NavDot}" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                <Ellipse Margin="3,3,0,0" Fill="{StaticResource StickerShadow}"/>
                <Ellipse x:Name="Disc" Margin="0,0,3,3" Fill="{TemplateBinding BorderBrush}" Stroke="{StaticResource InkSoft}" StrokeThickness="2"/>
                <Ellipse x:Name="Shine" Width="12" Height="8" Margin="13,11,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{StaticResource WhiteGlow}"/>
                <TextBlock x:Name="Glyph" Text="{TemplateBinding Tag}" FontFamily="{StaticResource FontIcon}" FontSize="{DynamicResource NavGlyph}" Margin="0,0,3,3"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}"/>
              </Grid>
              <ContentPresenter x:Name="Label" Margin="0,2,0,0" HorizontalAlignment="Center" RecognizesAccessKey="True"
                                TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontSize="{TemplateBinding FontSize}"/>
            </StackPanel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Disc" Property="Stroke" Value="{StaticResource Ink}"/>
              <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Disc" Property="Stroke" Value="{StaticResource InkStrong}"/>
              <Setter TargetName="Disc" Property="StrokeThickness" Value="3.5"/>
              <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
              <Setter Property="FontWeight" Value="ExtraBold"/>
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Sticker" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.06" Duration="0:0:0.12"/>
                    <DoubleAnimation Storyboard.TargetName="Sticker" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.06" Duration="0:0:0.12"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Sticker" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.12"/>
                    <DoubleAnimation Storyboard.TargetName="Sticker" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.12"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

