          <GeometryDrawing.Geometry><PathGeometry Figures="M 14,2 C 14.8,9 17.6,11.8 24.6,12.6 C 17.6,13.4 14.8,16.2 14,23.2 C 13.2,16.2 10.4,13.4 3.4,12.6 C 10.4,11.8 13.2,9 14,2 Z"/></GeometryDrawing.Geometry>
          <GeometryDrawing.Pen><Pen Brush="#FF5B3A29" Thickness="1.6" LineJoin="Round"/></GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Brush="#FFFED7E2">
          <GeometryDrawing.Geometry><PathGeometry Figures="M 31,17 C 31.4,21 33,22.6 37,23 C 33,23.4 31.4,25 31,29 C 30.6,25 29,23.4 25,23 C 29,22.6 30.6,21 31,17 Z"/></GeometryDrawing.Geometry>
          <GeometryDrawing.Pen><Pen Brush="#FF5B3A29" Thickness="1.4" LineJoin="Round"/></GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Brush="#FFE9D8FD"><GeometryDrawing.Geometry><EllipseGeometry Center="34,7" RadiusX="2.4" RadiusY="2.4"/></GeometryDrawing.Geometry></GeometryDrawing>
