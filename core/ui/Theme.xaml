  <LinearGradientBrush x:Key="ProgressFill" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#FFFF69B4" Offset="0"/>
    <GradientStop Color="#FFFFA9D4" Offset="1"/>
  </LinearGradientBrush>

  <!-- Giay cham tron rat nhat: cham 2 px #F3E6D3 cach 24 px -->
  <DrawingBrush x:Key="PaperDots" TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute" Viewbox="0,0,24,24" ViewboxUnits="Absolute" Stretch="None">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#00FFF6E8"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,24,24"/></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Brush="#FFF4E6D2"><GeometryDrawing.Geometry><EllipseGeometry Center="12,12" RadiusX="1" RadiusY="1"/></GeometryDrawing.Geometry></GeometryDrawing>
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>

  <!-- Giay note: dong ke ngang mo moi 28 px (khop LineHeight o link) -->
  <DrawingBrush x:Key="NoteLines" TileMode="Tile" Viewport="0,0,64,28" ViewportUnits="Absolute" Viewbox="0,0,64,28" ViewboxUnits="Absolute" Stretch="None">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#FFFFF6E6"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,64,28"/></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Brush="#33D9A441"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,27,64,1"/></GeometryDrawing.Geometry></GeometryDrawing>
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>

  <!-- ============================================================ trang tri vector (khong emoji) -->
