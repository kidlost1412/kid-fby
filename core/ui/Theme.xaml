  <!-- ============================================================ chu, ban kinh, khoang cach -->
  <FontFamily x:Key="FontUi">Segoe UI</FontFamily>
  <FontFamily x:Key="FontUiSemibold">Segoe UI Semibold</FontFamily>
  <FontFamily x:Key="FontUiBold">Segoe UI Black</FontFamily>
  <FontFamily x:Key="FontMono">Cascadia Mono, Consolas, Courier New</FontFamily>
  <FontFamily x:Key="FontIcon">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <!-- kich thuoc sidebar: code ghi de trong Window.Resources khi cua so thap (< 640 px) -->
  <sys:Double x:Key="NavDot">59</sys:Double>
  <sys:Double x:Key="NavBtnW">92</sys:Double>
  <sys:Double x:Key="NavBtnH">90</sys:Double>
  <sys:Double x:Key="NavGlyph">22</sys:Double>
  <Thickness x:Key="NavMargin">0,2,0,2</Thickness>
  <sys:Double x:Key="NavFont">14</sys:Double>
  <sys:Double x:Key="NavLabelGap">5</sys:Double>

  <!-- bien doi dung chung cho nut sticker (hover nhich len 1 px, nhan xuong 2 px) -->
  <TranslateTransform x:Key="LiftUp" X="0" Y="-1"/>
  <TranslateTransform x:Key="PressDown" X="1" Y="2"/>
  <TranslateTransform x:Key="NoShift" X="0" Y="0"/>

  <!-- ============================================================ focus -->
  <!-- Vien focus ban phim: lien, 2 px Accent, cach mat nut 3 px, cung bo goc (ban kinh = nua chieu cao). Khung focus WPF = vung cua nut (gom ca bong) nen Margin bu bong. -->
  <!-- o vuong/hang chu chung (CheckBox, Radio, cong tac, nav): bo goc 12 -->
  <Style x:Key="FocusRing">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-2" RadiusX="12" RadiusY="12" Stroke="{StaticResource Accent}" StrokeThickness="2" SnapsToDevicePixels="True"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- nut sticker chuan: nut cao 48 = mat 44 + bong 4 -> vien ngoai cao 52, ban kinh 26 -->
  <Style x:Key="FocusRingPill">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-4,-4,0,0" RadiusX="26" RadiusY="26" Stroke="{StaticResource Accent}" StrokeThickness="2" SnapsToDevicePixels="True"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- nut sticker nho: nut cao 45 = mat 42 + bong 3 -> vien ngoai cao 50, ban kinh 25 -->
  <Style x:Key="FocusRingPillSm">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-4,-4,-1,-1" RadiusX="25" RadiusY="25" Stroke="{StaticResource Accent}" StrokeThickness="2" SnapsToDevicePixels="True"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- o chon cao 48 khong bong -> vien ngoai cao 56, ban kinh 28 -->
  <Style x:Key="FocusRingCombo">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-4" RadiusX="28" RadiusY="28" Stroke="{StaticResource Accent}" StrokeThickness="2" SnapsToDevicePixels="True"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- chip cao 44 (mat 36 o giua) -> vien cao 44, ban kinh 22 -->
  <Style x:Key="FocusRingChip">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle RadiusX="22" RadiusY="22" Stroke="{StaticResource Accent}" StrokeThickness="2" SnapsToDevicePixels="True"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- nut tron vung bam 44 (nut tron 30) -> vien 38 -->
  <Style x:Key="FocusRingDot">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="3" RadiusX="19" RadiusY="19" Stroke="{StaticResource Accent}" StrokeThickness="2" SnapsToDevicePixels="True"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- nut tron phu tren video (dia 34 trong vung 44) -> vien 42 -->
  <Style x:Key="FocusRingOverlay">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="1" RadiusX="21" RadiusY="21" Stroke="{StaticResource Accent}" StrokeThickness="2" SnapsToDevicePixels="True"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================ chu -->
  <Style x:Key="Icon" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontIcon}"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
  </Style>
  <Style x:Key="TextTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
    <Setter Property="FontWeight" Value="ExtraBold"/>
    <Setter Property="FontSize" Value="28"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
  </Style>
  <Style x:Key="TextHeading" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
    <Setter Property="FontWeight" Value="ExtraBold"/>
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
  </Style>
  <Style x:Key="TextLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
  </Style>
  <Style x:Key="TextBody" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="LineHeight" Value="24"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="TextMutedStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="LineHeight" Value="21"/>
    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="TextSummaryLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="TextCaption" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
  </Style>

  <!-- ============================================================ the sticker -->
  <!-- Card (Border): bong cung lech kieu sticker (DropShadow BlurRadius 0). Dung cho vung lon it phan tu. -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Surface1}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Ink}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="CornerRadius" Value="20"/>
    <Setter Property="Padding" Value="20"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect ShadowDepth="4" Direction="315" BlurRadius="0" Color="#5B3A29" Opacity="0.18"/>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- The trong (khong bong): o ben trong the lon -->
  <Style x:Key="CardInset" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Surface2}"/>
    <Setter Property="BorderBrush" Value="{StaticResource InkSoft}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="CornerRadius" Value="16"/>
    <Setter Property="Padding" Value="14"/>
  </Style>
  <!-- StickerCard (ContentControl): bong la mot lop Border lech 4 px (re hon Effect, dung trong danh sach ao hoa) -->
  <Style x:Key="StickerCard" TargetType="ContentControl">
    <Setter Property="Background" Value="{StaticResource Surface1}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Ink}"/>
    <Setter Property="Padding" Value="20"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Grid SnapsToDevicePixels="True">
            <Border Margin="4,4,0,0" CornerRadius="23" Background="{StaticResource StickerShadow}"/>
            <Border Margin="0,0,4,4" CornerRadius="23" Background="#FFFFFFFF" Padding="3">
              <Border CornerRadius="20" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter/>
              </Border>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Badge" TargetType="Border">
    <Setter Property="CornerRadius" Value="16"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="Background" Value="{StaticResource NeutralSubtle}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Neutral}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimary}"/>
    <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
    <Style.Resources><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style></Style.Resources>
  </Style>
  <Style x:Key="Divider" TargetType="Border">
    <Setter Property="Height" Value="2"/>
    <Setter Property="CornerRadius" Value="1"/>
    <Setter Property="Background" Value="{StaticResource InkFaint}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>
  <!-- Chip bieu tuong tron mau pastel (moi trang mot mau) -->
  <Style x:Key="IconChip" TargetType="Border">
    <Setter Property="Width" Value="48"/>
    <Setter Property="Height" Value="48"/>
    <Setter Property="CornerRadius" Value="24"/>
    <Setter Property="BorderBrush" Value="{StaticResource Ink}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="Background" Value="{StaticResource Pink}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimary}"/>
  </Style>

  <!-- ============================================================ nut sticker -->
  <!-- Nut chuan: Button cao toi thieu 48 = mat 44 + bong 4 -> ban kinh mat 22 (= nua chieu cao). KHONG dung 999: WPF ep ban kinh theo tung truc rieng -> hinh bau duc. -->
  <ControlTemplate x:Key="ButtonBaseTemplate" TargetType="ButtonBase">
    <Grid x:Name="Root" SnapsToDevicePixels="True" Background="Transparent">
      <Border x:Name="Shadow" Margin="4,4,0,0" CornerRadius="22" Background="{StaticResource StickerShadow}"/>
      <Border x:Name="Face" Margin="0,0,4,4" CornerRadius="22" Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
        <Grid>
          <Border x:Name="Glow" CornerRadius="20" Background="{StaticResource WhiteGlow}" Visibility="Hidden"/>
