  </DrawingImage>

  <DrawingImage x:Key="DecoRibbon">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#00FFFFFF"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,200,26"/></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Brush="#FFFED7E2" Geometry="M 2,9 C 32,3 62,15 100,9 C 138,3 168,15 198,9 L 198,19 C 168,25 138,13 100,19 C 62,25 32,13 2,19 Z">
          <GeometryDrawing.Pen><Pen Brush="#FFF59ABD" Thickness="1.4" LineJoin="Round"/></GeometryDrawing.Pen>
