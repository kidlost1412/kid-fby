<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!--
    Kid FB.Y - he thong giao dien "cute" (dot 4): sticker de thuong, nen kem, pastel macaron, vien nau bo tron.
    Nap boi core\kid-fby-gui.ps1 (Window.Resources.MergedDictionaries) truoc khi hien cua so.
    MainWindow.xaml dung DynamicResource cho moi token/style vi dictionary nay duoc merge sau khi parse.
    Phong chu: code thay FontUi/FontUiSemibold/FontUiBold bang Nunito (core\ui\fonts) truoc khi merge;
    vi vay moi Setter FontFamily trong file nay dung DynamicResource. Thieu font -> Segoe UI.
    Code PowerShell lay mau qua Get-Brush <Token> (FindResource), khong dung ma hex.
  -->

  <!-- ============================================================ mau nen / be mat -->

  <SolidColorBrush x:Key="Surface0" Color="#FFFFFAF0"/>
  <SolidColorBrush x:Key="Surface1" Color="#FFFFFFFF"/>
  <SolidColorBrush x:Key="Surface2" Color="#FFFFF5F7"/>
  <SolidColorBrush x:Key="SurfaceAlt" Color="#FFFFF5F7"/>
  <SolidColorBrush x:Key="SurfaceInput" Color="#FFFFFFFF"/>
  <SolidColorBrush x:Key="Ink" Color="#E65B3A29"/>
  <SolidColorBrush x:Key="InkStrong" Color="#FF5B3A29"/>
  <SolidColorBrush x:Key="InkSoft" Color="#665B3A29"/>
  <SolidColorBrush x:Key="InkFaint" Color="#245B3A29"/>
  <SolidColorBrush x:Key="Border" Color="#E65B3A29"/>
  <SolidColorBrush x:Key="StickerShadow" Color="#2E5B3A29"/>

  <!-- chu: nau muc, khong dung den/xam lanh -->
