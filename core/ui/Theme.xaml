  <SolidColorBrush x:Key="Success" Color="#FFC6F6D5"/>
  <SolidColorBrush x:Key="SuccessText" Color="#FF276749"/>
  <SolidColorBrush x:Key="Warning" Color="#FFFEEBC8"/>
  <SolidColorBrush x:Key="WarningSubtle" Color="#FFFFF6E6"/>
  <SolidColorBrush x:Key="WarningText" Color="#FF8C6A1A"/>
