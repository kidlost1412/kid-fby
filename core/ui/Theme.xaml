    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingOverlay}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" Background="Transparent">
            <Ellipse x:Name="Hover" Width="34" Height="34" Fill="#33FFFFFF" Visibility="Hidden"/>
            <TextBlock x:Name="Glyph" Text="&#xE768;" FontFamily="{StaticResource FontIcon}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Content" Value="T&#x1EA1;m d&#x1EEB;ng">
              <Setter TargetName="Glyph" Property="Text" Value="&#xE769;"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Hover" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Glyph" Property="Opacity" Value="0.6"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Thanh tua phu tren video: ray mo trang, phan da xem hong, nut tron trang (vung bam 44) -->
  <Style x:Key="SeekSlider" TargetType="Slider">
    <Setter Property="Focusable" Value="True"/>
    <Setter Property="IsTabStop" Value="True"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="MinHeight" Value="44"/>
    <Setter Property="IsMoveToPointEnabled" Value="False"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid x:Name="SliderRoot" Background="Transparent" VerticalAlignment="Center" MinHeight="44">
            <Border x:Name="Rail" Height="8" CornerRadius="4" Background="#59FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" VerticalAlignment="Center"/>
            <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" IsTabStop="False">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton">
                      <Border Background="Transparent"><Border Height="8" CornerRadius="4" Margin="0,0,-8,0" Background="{StaticResource ProgressFill}" VerticalAlignment="Center"/></Border>
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="Slider.IncreaseLarge" Style="{DynamicResource SliderRepeat}"/>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb x:Name="Thumb" Width="18" Height="18" Focusable="False">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Ellipse Fill="White" Stroke="{StaticResource InkStrong}" StrokeThickness="2"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Rail" Property="BorderBrush" Value="White"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Nut "..." tren the Kho: an cho toi khi re chuot / focus ban phim vao the (DataTemplate dat Opacity=1) -->
  <Style x:Key="BtnCardMore" TargetType="Button" BasedOn="{StaticResource BtnOverlayIcon}">
    <Setter Property="Opacity" Value="0"/>
  </Style>

  <!-- Muc the Kho (ListViewItem): vien chon hong day quanh the, khong nen -->
  <Style x:Key="GalleryItemStyle" TargetType="ListViewItem">
    <Setter Property="AutomationProperties.Name" Value="{Binding AutomationText}"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Top"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListViewItem">
          <Grid Background="Transparent">
            <Border x:Name="Sel" CornerRadius="24" BorderThickness="3" BorderBrush="{StaticResource AccentPressed}" Background="{StaticResource PinkSoft}" Visibility="Hidden" Margin="2,2,2,2"/>
            <ContentPresenter Margin="6,6,6,6" HorizontalAlignment="Center" VerticalAlignment="Top"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Sel" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Sel" Property="Visibility" Value="Visible"/>
              <Setter TargetName="Sel" Property="Background" Value="Transparent"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Pill dem o day (Border): chu nau; bang 0 chi doi sang chu TextMuted + vien nhat (code), KHONG lam mo -->
  <Style x:Key="CountPill" TargetType="Border">
    <Setter Property="CornerRadius" Value="16"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimary}"/>
    <Style.Resources><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style></Style.Resources>
  </Style>

  <!-- Badge trang thai dong hang doi (DataContext = dong; truong Status): pill nen Soft + vien 2 px dam + chu nau -->
  <Style x:Key="StatusBadge" TargetType="Border">
    <Setter Property="CornerRadius" Value="15"/>
    <Setter Property="Height" Value="30"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Background" Value="{StaticResource NeutralSubtle}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Neutral}"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Status}" Value="running"><Setter Property="Background" Value="{StaticResource PinkSoft}"/><Setter Property="BorderBrush" Value="{StaticResource PinkLine}"/></DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="ok"><Setter Property="Background" Value="{StaticResource MintSoft}"/><Setter Property="BorderBrush" Value="{StaticResource MintLine}"/></DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="rejected"><Setter Property="Background" Value="{StaticResource ButterSoft}"/><Setter Property="BorderBrush" Value="{StaticResource ButterLine}"/></DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="skipped"><Setter Property="Background" Value="{StaticResource LavenderSoft}"/><Setter Property="BorderBrush" Value="{StaticResource LavenderLine}"/></DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="unverified"><Setter Property="Background" Value="{StaticResource SkySoft}"/><Setter Property="BorderBrush" Value="{StaticResource SkyLine}"/></DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="failed"><Setter Property="Background" Value="{StaticResource CoralSoft}"/><Setter Property="BorderBrush" Value="{StaticResource CoralLine}"/></DataTrigger>
    </Style.Triggers>
    <Style.Resources><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style></Style.Resources>
  </Style>
  <Style x:Key="StatusBadgeText" TargetType="TextBlock">
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
  </Style>

  <!-- Chuoi hat 7 buoc trong the hang doi (DataContext = chuoi: done | running | failed | pending) -->
  <Style x:Key="BeadDot" TargetType="Border">
    <Setter Property="Width" Value="20"/>
    <Setter Property="Height" Value="20"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="BorderBrush" Value="{StaticResource InkSoft}"/>
    <Setter Property="Background" Value="{StaticResource Surface1}"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding}" Value="done"><Setter Property="Background" Value="{StaticResource Mint}"/><Setter Property="BorderBrush" Value="{StaticResource Ink}"/></DataTrigger>
      <DataTrigger Binding="{Binding}" Value="failed"><Setter Property="Background" Value="{StaticResource Coral}"/><Setter Property="BorderBrush" Value="{StaticResource Ink}"/></DataTrigger>
      <DataTrigger Binding="{Binding}" Value="running">
        <Setter Property="Background" Value="{StaticResource Pink}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Ink}"/>
        <DataTrigger.EnterActions>
          <BeginStoryboard x:Name="BeadPulse">
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.45" Duration="0:0:0.7" AutoReverse="True" RepeatBehavior="Forever"/>
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.EnterActions>
        <DataTrigger.ExitActions>
          <StopStoryboard BeginStoryboardName="BeadPulse"/>
        </DataTrigger.ExitActions>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="BeadGlyph" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontIcon}"/>
    <Setter Property="FontSize" Value="9"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    <Setter Property="Text" Value=""/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding}" Value="done"><Setter Property="Text" Value="&#xE73E;"/></DataTrigger>
      <DataTrigger Binding="{Binding}" Value="failed"><Setter Property="Text" Value="&#xE711;"/></DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Buoc 1-7 trong the chi tiet (truong State: done | running | failed | pending) -->
  <Style x:Key="StepDot" TargetType="Border">
    <Setter Property="Width" Value="40"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="CornerRadius" Value="20"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="BorderBrush" Value="{StaticResource InkSoft}"/>
    <Setter Property="Background" Value="{StaticResource Surface1}"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding State}" Value="done"><Setter Property="Background" Value="{StaticResource Mint}"/><Setter Property="BorderBrush" Value="{StaticResource Ink}"/></DataTrigger>
      <DataTrigger Binding="{Binding State}" Value="running">
        <Setter Property="Background" Value="{StaticResource Pink}"/>
        <Setter Property="BorderBrush" Value="{StaticResource InkStrong}"/>
        <Setter Property="BorderThickness" Value="3"/>
        <DataTrigger.EnterActions>
          <BeginStoryboard x:Name="StepPulse">
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.55" Duration="0:0:0.7" AutoReverse="True" RepeatBehavior="Forever"/>
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.EnterActions>
        <DataTrigger.ExitActions>
          <StopStoryboard BeginStoryboardName="StepPulse"/>
        </DataTrigger.ExitActions>
      </DataTrigger>
      <DataTrigger Binding="{Binding State}" Value="failed"><Setter Property="Background" Value="{StaticResource Coral}"/><Setter Property="BorderBrush" Value="{StaticResource Ink}"/></DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="StepGlyph" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
  </Style>
  <Style x:Key="StepName" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
    <Setter Property="TextAlignment" Value="Center"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding State}" Value="done"><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/></DataTrigger>
      <DataTrigger Binding="{Binding State}" Value="running">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding State}" Value="failed"><Setter Property="Foreground" Value="{StaticResource DangerText}"/></DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Nut hanh dong trong the hang doi (an khi ActionKind rong): pill tron, mau theo hanh dong -->
  <Style x:Key="RowActionButton" TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
    <Setter Property="Template" Value="{StaticResource ButtonBaseTemplateSm}"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingPillSm}"/>
    <Setter Property="Padding" Value="18,0"/>
    <Setter Property="MinHeight" Value="45"/>
    <Setter Property="FontSize" Value="14"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding ActionKind}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
      <DataTrigger Binding="{Binding ActionKind}" Value="open"><Setter Property="Background" Value="{StaticResource Mint}"/></DataTrigger>
      <DataTrigger Binding="{Binding ActionKind}" Value="retry"><Setter Property="Background" Value="{StaticResource Peach}"/></DataTrigger>
      <DataTrigger Binding="{Binding ActionKind}" Value="unreject"><Setter Property="Background" Value="{StaticResource Butter}"/></DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Nut trang thai TikTok trong Kho (truong Posted): pill, da dang = Mint -->
  <Style x:Key="BtnTikTok" TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
    <Setter Property="Template" Value="{StaticResource ButtonBaseTemplateSm}"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingPillSm}"/>
    <Setter Property="Padding" Value="18,0"/>
    <Setter Property="MinHeight" Value="45"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Background" Value="{StaticResource LavenderSoft}"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Posted}" Value="True">
        <Setter Property="Background" Value="{StaticResource Mint}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- ============================================================ o nhap -->
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource SurfaceInput}"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    <Setter Property="CaretBrush" Value="{StaticResource InkStrong}"/>
    <Setter Property="SelectionBrush" Value="{StaticResource Pink}"/>
    <Setter Property="BorderBrush" Value="{StaticResource InkSoft}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="Padding" Value="14,8"/>
    <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="MinHeight" Value="48"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18" SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="{TemplateBinding Padding}"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Ink}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentPressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="TextBoxPath" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Style.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="False"><Setter Property="Foreground" Value="Transparent"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="TextBoxMono" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="VerticalContentAlignment" Value="Top"/>
  </Style>
  <!-- O link nhu to giay note: nen vang bo, dong ke mo 28 px -->
  <Style x:Key="NotePaper" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="Background" Value="{StaticResource NoteLines}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Ink}"/>
    <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="TextBlock.LineHeight" Value="28"/>
    <Setter Property="TextBlock.LineStackingStrategy" Value="BlockLineHeight"/>
    <Setter Property="VerticalContentAlignment" Value="Top"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="2" CornerRadius="20" SnapsToDevicePixels="True" ClipToBounds="True">
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="{TemplateBinding Padding}"
                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentPressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================ ComboBox (vien thuoc cao 48 = ban kinh 24, popup sticker) -->
  <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{StaticResource InkSoft}" BorderThickness="2" CornerRadius="24" SnapsToDevicePixels="True">
      <TextBlock x:Name="Arrow" Text="&#xE70D;" FontFamily="{StaticResource FontIcon}" FontSize="12" Foreground="{StaticResource TextMuted}"
                 HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"/>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Ink}"/>
        <Setter TargetName="Bd" Property="Background" Value="{StaticResource ButterSoft}"/>
      </Trigger>
      <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentPressed}"/>
        <Setter TargetName="Arrow" Property="Foreground" Value="{StaticResource TextPrimary}"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceAlt}"/>
        <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="16,0"/>
    <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="20" Height="40" Padding="{TemplateBinding Padding}" Margin="2,1" SnapsToDevicePixels="True">
            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource ButterSoft}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource PinkSoft}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="Height" Value="48"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingCombo}"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid x:Name="Root">
            <ToggleButton x:Name="ToggleButton" Template="{StaticResource ComboBoxToggleButton}" Background="{StaticResource Surface1}" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Margin="20,0,44,0"
                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                              VerticalAlignment="Center" HorizontalAlignment="Left" TextElement.Foreground="{TemplateBinding Foreground}"/>
            <Rectangle x:Name="DisabledRing" Margin="1" RadiusX="23" RadiusY="23" Stroke="{StaticResource InkSoft}" StrokeThickness="2"
                       StrokeDashArray="3 2" Fill="Transparent" Visibility="Collapsed" IsHitTestVisible="False"/>
            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" PopupAnimation="Fade">
              <Grid Margin="0,6,6,6">
                <Border Margin="4,4,0,0" CornerRadius="16" Background="{StaticResource StickerShadow}"/>
                <Border Background="{StaticResource Surface1}" BorderBrush="{StaticResource Ink}" BorderThickness="2" CornerRadius="16"
                        MinWidth="{Binding ActualWidth, ElementName=Root}" MaxHeight="320" Margin="0,0,4,4" Padding="6">
                  <ScrollViewer SnapsToDevicePixels="True" VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                  </ScrollViewer>
                </Border>
              </Grid>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="DisabledRing" Property="Visibility" Value="Visible"/>
              <Setter TargetName="ContentSite" Property="TextElement.Foreground" Value="{StaticResource TextMuted}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================ CheckBox / cong tac / RadioButton -->
  <Style TargetType="CheckBox">
    <Setter Property="MinHeight" Value="44"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="Box" Width="26" Height="26" CornerRadius="9" BorderThickness="2" BorderBrush="{StaticResource Ink}"
                    Background="{StaticResource Surface1}" VerticalAlignment="Center">
              <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="{StaticResource FontIcon}" FontSize="13" Foreground="{StaticResource TextPrimary}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Border>
            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"
                              TextElement.Foreground="{TemplateBinding Foreground}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource ButterSoft}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource Mint}"/>
              <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
              <Setter TargetName="Box" Property="Background" Value="{StaticResource NeutralSubtle}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Cong tac bat/tat (CheckBox): ray 54x30 tron, nut trang truot -->
  <Style x:Key="ToggleSwitch" TargetType="CheckBox">
    <Setter Property="MinHeight" Value="44"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid Width="58" Height="33" VerticalAlignment="Top" Margin="0,2,0,0">
              <Border Margin="3,3,0,0" CornerRadius="15" Background="{StaticResource StickerShadow}"/>
              <Border x:Name="Track" Margin="0,0,3,3" CornerRadius="15" BorderThickness="2" BorderBrush="{StaticResource Ink}" Background="{StaticResource NeutralSubtle}">
                <Ellipse x:Name="Knob" Width="20" Height="20" Margin="4,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                         Fill="{StaticResource Surface1}" Stroke="{StaticResource Ink}" StrokeThickness="2"/>
              </Border>
            </Grid>
            <ContentPresenter Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"
                              TextElement.Foreground="{TemplateBinding Foreground}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{StaticResource Mint}"/>
              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="RadioButton">
    <Setter Property="MinHeight" Value="44"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid Width="24" Height="24" VerticalAlignment="Center">
              <Ellipse x:Name="Ring" Stroke="{StaticResource Ink}" StrokeThickness="2" Fill="{StaticResource Surface1}"/>
              <Ellipse x:Name="Dot" Width="12" Height="12" Fill="{StaticResource Accent}" Visibility="Collapsed"/>
            </Grid>
            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"
                              TextElement.Foreground="{TemplateBinding Foreground}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Ring" Property="Fill" Value="{StaticResource ButterSoft}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Ring" Property="Fill" Value="{StaticResource PinkSoft}"/>
              <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
              <Setter TargetName="Ring" Property="Fill" Value="{StaticResource NeutralSubtle}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================ Slider (Focusable=True): ray tron day, nut tron trang -->
  <Style x:Key="SliderRepeat" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="Slider">
    <Setter Property="Focusable" Value="True"/>
    <Setter Property="IsTabStop" Value="True"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="MinHeight" Value="44"/>
    <Setter Property="IsMoveToPointEnabled" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid x:Name="SliderRoot" Background="Transparent" VerticalAlignment="Center" MinHeight="44">
            <Border x:Name="Rail" Height="9" CornerRadius="5" Background="{StaticResource PinkSoft}" BorderBrush="{StaticResource InkSoft}" BorderThickness="1.5" VerticalAlignment="Center"/>
            <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" IsTabStop="False">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton">
                      <Border Background="Transparent"><Border Height="9" CornerRadius="5" Margin="0,0,-10,0" Background="{StaticResource ProgressFill}" BorderBrush="{StaticResource InkSoft}" BorderThickness="1.5" VerticalAlignment="Center"/></Border>
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderRepeat}"/>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb x:Name="Thumb" Width="26" Height="26" Focusable="False">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Grid>
                        <Ellipse Margin="2,2,0,0" Fill="{StaticResource StickerShadow}"/>
                        <Ellipse x:Name="Knob" Margin="0,0,2,2" Fill="{StaticResource Surface1}" Stroke="{StaticResource InkStrong}" StrokeThickness="2"/>
                        <Ellipse Width="6" Height="6" Margin="0,0,2,2" Fill="{StaticResource Accent}"/>
                      </Grid>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Rail" Property="BorderBrush" Value="{StaticResource AccentPressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="SliderRoot" Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================ ScrollBar tron be -->
  <Style x:Key="ScrollThumb" TargetType="Thumb">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="T" CornerRadius="5" Background="#FFE9D7C3"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="Background" Value="#FFD9BFA6"/></Trigger>
            <Trigger Property="IsDragging" Value="True"><Setter TargetName="T" Property="Background" Value="{StaticResource PinkLine}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="12"/>
    <Setter Property="MinWidth" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource SliderRepeat}"/></Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource SliderRepeat}"/></Track.IncreaseRepeatButton>
              <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" Margin="2,2"/></Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="MinHeight" Value="12"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Grid Background="{TemplateBinding Background}">
                <Track x:Name="PART_Track" IsDirectionReversed="False">
                  <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource SliderRepeat}"/></Track.DecreaseRepeatButton>
                  <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource SliderRepeat}"/></Track.IncreaseRepeatButton>
                  <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" Margin="2,2"/></Track.Thumb>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ============================================================ ContextMenu / MenuItem sticker -->
  <Style TargetType="ContextMenu">
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="HasDropShadow" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Grid Margin="0,0,6,6">
            <Border Margin="4,4,-2,-2" CornerRadius="18" Background="{StaticResource StickerShadow}"/>
            <Border Background="{StaticResource Surface1}" BorderBrush="{StaticResource Ink}" BorderThickness="2" CornerRadius="18" Padding="6" MinWidth="210">
              <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="12" Padding="10,0" MinHeight="44" Margin="0,1" SnapsToDevicePixels="True">
            <DockPanel>
              <TextBlock x:Name="Glyph" DockPanel.Dock="Left" Text="{TemplateBinding Tag}" FontFamily="{StaticResource FontIcon}" FontSize="15" Width="24" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
              <TextBlock DockPanel.Dock="Right" Text="{TemplateBinding InputGestureText}" FontSize="13" FontWeight="Normal" Margin="18,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
              <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource ButterSoft}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="2" CornerRadius="1" Background="{StaticResource InkFaint}" Margin="8,4"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================ ToolTip sticker nho -->
  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{StaticResource Surface1}"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Ink}"/>
    <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Padding" Value="12,7"/>
    <Setter Property="HasDropShadow" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Grid Margin="0,0,4,4">
            <Border Margin="3,3,-3,-3" CornerRadius="14" Background="{StaticResource StickerShadow}"/>
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" CornerRadius="14"
                    Padding="{TemplateBinding Padding}" MaxWidth="420">
              <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}">
                <ContentPresenter.Resources>
                  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                </ContentPresenter.Resources>
              </ContentPresenter>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================ ProgressBar: ong tron 14 px, day gradient Pink -> Peach, ngoi sao chay o dau -->
  <Style TargetType="ProgressBar">
    <Setter Property="Foreground" Value="{StaticResource ProgressFill}"/>
    <Setter Property="Background" Value="{StaticResource PinkSoft}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Height" Value="22"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid x:Name="TemplateRoot" ClipToBounds="False" Height="22">
            <Border Height="14" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{StaticResource InkSoft}" BorderThickness="1.5" VerticalAlignment="Center"/>
            <Border x:Name="PART_Track" Height="14" Margin="0,0,0,0" VerticalAlignment="Center"/>
            <Grid x:Name="PART_Indicator" HorizontalAlignment="Left" VerticalAlignment="Center" Height="22">
              <Border x:Name="Fill" Height="14" CornerRadius="7" Background="{TemplateBinding Foreground}" BorderBrush="{StaticResource InkSoft}" BorderThickness="1.5" VerticalAlignment="Center"/>
              <Path x:Name="HeadStar" Data="{StaticResource GeoSparkle}" Width="20" Height="20" Stretch="Uniform" Fill="{StaticResource Butter}" Stroke="{StaticResource InkStrong}" StrokeThickness="1.4"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-10,0"/>
            </Grid>
            <Border x:Name="Indeterminate" Height="14" CornerRadius="7" Background="{TemplateBinding Foreground}" BorderBrush="{StaticResource InkSoft}" BorderThickness="1.5"
                    VerticalAlignment="Center" Visibility="Collapsed" Opacity="0.4"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Value" Value="0">
              <Setter TargetName="HeadStar" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="Fill" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="IsIndeterminate" Value="True">
              <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="Indeterminate" Property="Visibility" Value="Visible"/>
              <Trigger.EnterActions>
                <BeginStoryboard x:Name="IndetPulse">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Indeterminate" Storyboard.TargetProperty="Opacity" From="0.35" To="1" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <StopStoryboard BeginStoryboardName="IndetPulse"/>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================ ListView: muc la the sticker trong DataTemplate -->
  <Style TargetType="ListView">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    <Setter Property="FontFamily" Value="{DynamicResource FontUi}"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
    <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
    <Setter Property="KeyboardNavigation.TabNavigation" Value="Once"/>
  </Style>
  <Style TargetType="ListViewItem">
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0,0,0,8"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListViewItem">
          <Grid Background="Transparent">
            <Border x:Name="Sel" CornerRadius="24" BorderThickness="3" BorderBrush="{StaticResource AccentPressed}" Background="{StaticResource PinkSoft}"
                    Visibility="Hidden" Margin="0,0,0,0"/>
            <ContentPresenter Margin="5,5,5,5"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Sel" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Sel" Property="Visibility" Value="Visible"/>
              <Setter TargetName="Sel" Property="Background" Value="Transparent"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="DataGridRow">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource ButterSoft}"/></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource PinkSoft}"/></Trigger>
    </Style.Triggers>
  </Style>

  <!-- ============================================================ Expander (giu cho tuong thich) -->
  <Style TargetType="Expander">
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Expander">
          <Border Background="{StaticResource Surface1}" BorderBrush="{StaticResource Ink}" BorderThickness="2" CornerRadius="20">
            <DockPanel>
              <ToggleButton x:Name="Header" DockPanel.Dock="Top" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                            Cursor="Hand" FocusVisualStyle="{StaticResource FocusRing}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" Padding="18,14">
                      <DockPanel>
                        <TextBlock x:Name="Chevron" DockPanel.Dock="Right" Text="&#xE70D;" FontFamily="{StaticResource FontIcon}" FontSize="12"
                                   Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                        <ContentPresenter VerticalAlignment="Center"/>
                      </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Text" Value="&#xE70E;"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
                <ContentPresenter Content="{TemplateBinding Header}" TextElement.FontWeight="ExtraBold" TextElement.Foreground="{TemplateBinding Foreground}"/>
              </ToggleButton>
              <ContentPresenter x:Name="Body" Margin="18,0,18,18" Visibility="Collapsed"/>
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Mau 7 buoc thu gon (man hinh thap): mot dong cham cao 36; ten buoc nam trong tooltip -->
  <DataTemplate x:Key="StepTemplateCompact">
    <Grid Height="36" ToolTip="{Binding Detail}" AutomationProperties.Name="{Binding Name}">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border x:Name="LineL" Height="4" CornerRadius="2" Background="{StaticResource InkFaint}" VerticalAlignment="Center"/>
      <Border x:Name="LineR" Grid.Column="1" Height="4" CornerRadius="2" Background="{StaticResource InkFaint}" VerticalAlignment="Center"/>
      <Border Grid.ColumnSpan="2" Style="{StaticResource StepDot}" Width="28" Height="28" CornerRadius="14" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid>
          <TextBlock x:Name="StepNo" Text="{Binding No}" FontWeight="ExtraBold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}"/>
          <TextBlock x:Name="StepIcon" Text="{Binding Glyph}" Style="{StaticResource StepGlyph}" FontSize="12" Visibility="Collapsed"/>
        </Grid>
      </Border>
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Edge}" Value="first"><Setter TargetName="LineL" Property="Visibility" Value="Hidden"/></DataTrigger>
      <DataTrigger Binding="{Binding Edge}" Value="last"><Setter TargetName="LineR" Property="Visibility" Value="Hidden"/></DataTrigger>
      <DataTrigger Binding="{Binding State}" Value="done">
        <Setter TargetName="StepNo" Property="Visibility" Value="Collapsed"/><Setter TargetName="StepIcon" Property="Visibility" Value="Visible"/>
        <Setter TargetName="LineL" Property="Background" Value="{StaticResource MintLine}"/><Setter TargetName="LineR" Property="Background" Value="{StaticResource MintLine}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding State}" Value="failed">
        <Setter TargetName="StepNo" Property="Visibility" Value="Collapsed"/><Setter TargetName="StepIcon" Property="Visibility" Value="Visible"/>
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
</ResourceDictionary>
