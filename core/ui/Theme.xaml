      <DrawingGroup>
        <GeometryDrawing Brush="#FFFED7E2" Geometry="{StaticResource GeoHeart}">
          <GeometryDrawing.Pen><Pen Brush="#FF5B3A29" Thickness="1.8" LineJoin="Round"/></GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Brush="#CCFFFFFF"><GeometryDrawing.Geometry><EllipseGeometry Center="6.8,7" RadiusX="1.8" RadiusY="1.3"/></GeometryDrawing.Geometry></GeometryDrawing>
      </DrawingGroup>
