{
  "manifest_version": 3,
  "name": "AutoTok P0 (thu nghiem)",
  "description": "Prototype P0: dang TikTok tu Chrome that. Chi dung de thu.",
  "version": "0.0.1",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": ["https://www.tiktok.com/*", "http://127.0.0.1:8799/*"],
  "background": { "service_worker": "sw.js" },
  "content_scripts": [
    {
      "matches": ["https://www.tiktok.com/tiktokstudio/*"],
      "js": ["hook-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.tiktok.com/tiktokstudio/*"],
      "js": ["selectors.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "action": { "default_title": "AutoTok P0", "default_popup": "popup.html" }
}
